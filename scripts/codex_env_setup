#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

DEFAULT_INTERNAL_BIN="$HOME/.local/bin/codex"
DEFAULT_OFFICIAL_BIN="/Applications/ChatGPT.app/Contents/Resources/codex"
DEFAULT_INSTALLER_URL="https://github.com/SDGLBL/codex/releases/latest/download/install.sh"
DEFAULT_LATEST_URL="https://github.com/SDGLBL/codex/releases/latest"
DEFAULT_MODEL="gpt-5.5-2026-04-24"
DEFAULT_AZURE_BASE_URL="https://aidp.bytedance.net/api/modelhub/online"
DEFAULT_PROXY_URL="http://sys-proxy-rd-relay.byted.org:8118"
TEAM_DOC_URL="https://bytedance.larkoffice.com/docx/OOYBdDO2MoSU7nxb8iLcQAWMnPf"

INTERNAL_BIN="${CODEX_INTERNAL_BIN:-$DEFAULT_INTERNAL_BIN}"
OFFICIAL_BIN="${CODEX_OFFICIAL_BIN:-$DEFAULT_OFFICIAL_BIN}"
INSTALLER_URL="${CODEX_INSTALLER_URL:-$DEFAULT_INSTALLER_URL}"
LATEST_URL="${CODEX_INTERNAL_LATEST_URL:-$DEFAULT_LATEST_URL}"
INSTALL_DIR="${CODEX_INSTALL_DIR:-$HOME/.local/bin}"
INSTALL_DIR_EXPLICIT=0
[[ -n "${CODEX_INSTALL_DIR+x}" ]] && INSTALL_DIR_EXPLICIT=1
INSTALL_VERSION="${CODEX_INSTALL_VERSION:-}"
INSTALL_MODEL="${CODEX_INSTALL_MODEL:-$DEFAULT_MODEL}"
INSTALL_AZURE_BASE_URL="${CODEX_INSTALL_AZURE_BASE_URL:-$DEFAULT_AZURE_BASE_URL}"
INSTALL_PROXY_URL="${CODEX_INSTALL_PROXY_URL:-$DEFAULT_PROXY_URL}"
SKIP_SOURCE_CHECK=0
SKIP_PROXY=0
DRY_RUN=0
PYTHON_BIN="${CODEX_SWITCH_PYTHON:-python3}"
INTERNAL_CANDIDATE_LAYOUT="legacy"
FIRST_INSTALL=0

usage() {
  cat <<'USAGE'
Usage:
  codex-switch env [global options] <command> [command options]
  codex-switch <check-internal|check-official|update-internal|desktop-guidance> [options]

Commands:
  check-internal           Read-only check for the internal Codex CLI version.
  update-internal          Install or update the internal Codex CLI.
  check-official           Read-only check for ChatGPT.app bundled CLI.
  desktop-guidance         Print ChatGPT Desktop setup guidance.

Global options:
  --internal-bin <path>        Internal codex binary. Default: ~/.local/bin/codex.
  --official-bin <path>        Official ChatGPT.app bundled Codex binary.
  --install-dir <path>         Internal install directory. Default: ~/.local/bin.
  --installer-url <url>        Internal install.sh URL.
  --latest-url <url>           Internal latest release URL.
  --version <version>          Pin internal install version.
  --model <model>              CODEX_INSTALL_MODEL.
  --azure-base-url <url>       CODEX_INSTALL_AZURE_BASE_URL.
  --skip-source-check          Skip Lark install-source verification.
  --skip-proxy                 Do not set the default company proxy.
  --dry-run                    Print planned actions only.

Examples:
  codex-switch env check-internal
  codex-switch update-internal --dry-run
  codex-switch update-internal
  codex-switch check-official
USAGE
}

expand_shell_path() {
  local raw="$1"
  case "$raw" in
    "~") printf '%s\n' "$HOME" ;;
    "~/"*) printf '%s/%s\n' "$HOME" "${raw#~/}" ;;
    *) printf '%s\n' "$raw" ;;
  esac
}

extract_version() {
  sed -nE 's/.*([0-9]+[.][0-9]+[.][0-9]+([-+][A-Za-z0-9.]+)?).*/\1/p' | head -n 1
}

latest_internal_tag() {
  local headers location
  headers="$(curl -fsSLI --max-time 20 "$LATEST_URL" 2>/dev/null)" || return 1
  location="$(printf '%s\n' "$headers" | awk 'tolower($1) == "location:" { print $2 }' | tail -n 1 | tr -d '\r')"
  printf '%s\n' "${location##*/}"
}

internal_update_decision() {
  local current_version="$1"
  local latest_version="$2"
  "$PYTHON_BIN" -I -B -c '
import sys

sys.path.insert(0, sys.argv[1])
from codex_switch_update_policy import decide_internal_update

decision = decide_internal_update(
    current_version=sys.argv[2] or None,
    latest_version=sys.argv[3] or None,
)
print(
    "\t".join(
        (
            decision.outcome,
            decision.target_version or "",
            decision.reason,
        )
    )
)
' "$SCRIPT_DIR" "$current_version" "$latest_version"
}

strict_semantic_version_from_output() {
  "$PYTHON_BIN" -I -B -c '
import sys

sys.path.insert(0, sys.argv[1])
from codex_switch_update_policy import extract_semantic_version

version = extract_semantic_version(sys.stdin.read())
if version is None:
    raise SystemExit(1)
print(version)
' "$SCRIPT_DIR"
}

internal_install_version_is_valid() {
  "$PYTHON_BIN" -I -B -c '
import sys

sys.path.insert(0, sys.argv[1])
from codex_switch_update_policy import parse_semantic_version

value = sys.argv[2]
raise SystemExit(
    0
    if value == value.strip() and parse_semantic_version(value) is not None
    else 1
)
' "$SCRIPT_DIR" "$1"
}

validate_staged_candidate_request() {
  "$PYTHON_BIN" -I -B - \
    "$INTERNAL_BIN" \
    "$INSTALL_DIR" \
    "$INSTALL_DIR_EXPLICIT" "$FIRST_INSTALL" <<'PY'
import os
import stat
import sys
from pathlib import Path


def fail(detail: str) -> None:
    print(
        "Internal candidate directory must be a private sibling of the "
        f"bound codex binary: {detail}",
        file=sys.stderr,
    )
    raise SystemExit(2)


bound = Path(os.path.expandvars(sys.argv[1])).expanduser()
candidate = Path(os.path.expandvars(sys.argv[2])).expanduser()
if sys.argv[3] != "1":
    fail("an explicit --install-dir or CODEX_INSTALL_DIR is required")
if not bound.is_absolute() or not candidate.is_absolute():
    fail("bound and candidate paths must be absolute")
if bound.name != "codex":
    fail(f"bound binary basename must be codex: {bound}")
try:
    bound_state = os.lstat(bound)
except FileNotFoundError:
    if sys.argv[4] != "1":
        fail(f"bound binary is unavailable: {bound}")
    bound_state = None
except OSError as error:
    fail(f"bound binary is unavailable: {error}")
if sys.argv[4] == "1" and bound_state is not None:
    fail("first-install target already exists")
if bound_state is not None and (
    stat.S_ISLNK(bound_state.st_mode)
    or not stat.S_ISREG(bound_state.st_mode)
    or bound_state.st_mode & 0o111 == 0
):
    fail(f"bound binary must be a regular executable: {bound}")
if not candidate.name.startswith(".codex-internal-update-"):
    fail(
        "candidate basename must start with .codex-internal-update-: "
        f"{candidate}"
    )
if os.path.lexists(candidate):
    fail(f"candidate path must not already exist: {candidate}")
try:
    bound_parent = bound.parent.resolve(strict=True)
    candidate_parent = candidate.parent.resolve(strict=True)
except OSError as error:
    fail(f"candidate parent is unavailable: {error}")
if candidate_parent != bound_parent:
    fail(
        f"candidate parent {candidate_parent} does not match bound parent "
        f"{bound_parent}"
    )
print(candidate)
PY
}

staged_candidate_directory_identity() {
  "$PYTHON_BIN" -I -B - "$1" <<'PY'
import os
import stat
import sys
from pathlib import Path

path = Path(sys.argv[1])
try:
    state = os.lstat(path)
except OSError as error:
    print(f"Internal candidate directory is unavailable: {error}", file=sys.stderr)
    raise SystemExit(2)
if (
    stat.S_ISLNK(state.st_mode)
    or not stat.S_ISDIR(state.st_mode)
    or stat.S_IMODE(state.st_mode) != 0o700
):
    print(
        f"Internal candidate directory is not a private mode-0700 directory: {path}",
        file=sys.stderr,
    )
    raise SystemExit(2)
print(f"{state.st_dev}:{state.st_ino}")
PY
}

validate_staged_candidate_executable() {
  "$PYTHON_BIN" -I -B - "$1" <<'PY'
import os
import stat
import sys
from pathlib import Path

path = Path(sys.argv[1])
try:
    state = os.lstat(path)
except OSError as error:
    print(f"Internal candidate executable is unavailable: {error}", file=sys.stderr)
    raise SystemExit(1)
if (
    stat.S_ISLNK(state.st_mode)
    or not stat.S_ISREG(state.st_mode)
    or state.st_mode & 0o111 == 0
    or state.st_size <= 0
):
    print(
        f"Internal candidate must be a non-empty regular executable: {path}",
        file=sys.stderr,
    )
    raise SystemExit(1)
PY
}

bound_binary_identity() {
  "$PYTHON_BIN" -I -B - "$1" "$FIRST_INSTALL" <<'PY'
import hashlib
import json
import os
import stat
import sys
from pathlib import Path


def fail(detail: str) -> None:
    print(
        f"Bound internal binary identity is unavailable: {detail}",
        file=sys.stderr,
    )
    raise SystemExit(1)


def identity_fields(state: os.stat_result) -> tuple[int, ...]:
    return (
        state.st_dev,
        state.st_ino,
        state.st_mode,
        state.st_size,
        state.st_mtime_ns,
        state.st_ctime_ns,
    )


path = Path(sys.argv[1])
if sys.argv[2] == "1":
    try:
        path.lstat()
    except FileNotFoundError:
        print("absent")
        raise SystemExit(0)
    fail(f"first-install target appeared: {path}")
if not hasattr(os, "O_NOFOLLOW"):
    fail("no-follow file open is unsupported")
flags = os.O_RDONLY | os.O_NOFOLLOW
if hasattr(os, "O_CLOEXEC"):
    flags |= os.O_CLOEXEC
try:
    descriptor = os.open(path, flags)
except OSError as error:
    fail(f"{path}: {error}")
try:
    before = os.fstat(descriptor)
    if (
        not stat.S_ISREG(before.st_mode)
        or before.st_mode & 0o111 == 0
        or before.st_size <= 0
    ):
        fail(f"{path} is not a non-empty regular executable")
    digest = hashlib.sha256()
    while True:
        chunk = os.read(descriptor, 1024 * 1024)
        if not chunk:
            break
        digest.update(chunk)
    after = os.fstat(descriptor)
    try:
        linked = os.stat(path, follow_symlinks=False)
    except OSError as error:
        fail(f"{path}: {error}")
    if (
        identity_fields(before) != identity_fields(after)
        or identity_fields(after) != identity_fields(linked)
    ):
        fail(f"{path} changed while its identity was read")
    print(
        json.dumps(
            {
                "ctime_ns": after.st_ctime_ns,
                "device": after.st_dev,
                "inode": after.st_ino,
                "mode": after.st_mode,
                "mtime_ns": after.st_mtime_ns,
                "sha256": digest.hexdigest(),
                "size": after.st_size,
            },
            sort_keys=True,
            separators=(",", ":"),
        )
    )
finally:
    os.close(descriptor)
PY
}

assert_bound_binary_identity() {
  local expected_identity="$1"
  local phase="$2"
  local observed_identity status

  if observed_identity="$(bound_binary_identity "$INTERNAL_BIN")"; then
    true
  else
    status=$?
    echo "Bound internal binary identity check failed $phase: $INTERNAL_BIN" >&2
    return "$status"
  fi
  if [[ "$observed_identity" != "$expected_identity" ]]; then
    echo "Bound internal binary changed $phase: $INTERNAL_BIN" >&2
    return 1
  fi
}

manage_installer_scratch() {
  "$PYTHON_BIN" -I -B - "$@" <<'PY'
import os
import shutil
import stat
import sys
from pathlib import Path

action = sys.argv[1]
path = Path(sys.argv[2])
tmp_root = Path("/tmp").resolve(strict=True)
if (
    not path.is_absolute()
    or not path.name.startswith("codex-switch-internal-installer.")
    or path.parent.resolve(strict=True) != tmp_root
):
    print("Internal installer scratch path is invalid.", file=sys.stderr)
    raise SystemExit(1)
state = os.lstat(path)
if (
    stat.S_ISLNK(state.st_mode)
    or not stat.S_ISDIR(state.st_mode)
):
    print(
        "Internal installer scratch root is not a private directory.",
        file=sys.stderr,
    )
    raise SystemExit(1)
identity = f"{state.st_dev}:{state.st_ino}"

if action == "identity":
    if stat.S_IMODE(state.st_mode) != 0o700:
        print(
            "Internal installer scratch root is not mode 0700.",
            file=sys.stderr,
        )
        raise SystemExit(1)
    print(identity)
elif action == "cleanup-empty":
    os.rmdir(path)
elif action == "cleanup":
    if len(sys.argv) != 4 or identity != sys.argv[3]:
        print("Refusing to clean foreign installer scratch state.", file=sys.stderr)
        raise SystemExit(1)
    shutil.rmtree(path)
else:
    print("Unknown internal installer scratch action.", file=sys.stderr)
    raise SystemExit(1)

if action.startswith("cleanup") and os.path.lexists(path):
    print("Internal installer scratch cleanup was incomplete.", file=sys.stderr)
    raise SystemExit(1)
PY
}

run_trusted_internal_installer() {
  local install_ak="$1"
  local status installer_root installer_identity cleanup_status
  local installer_signal_status installer_pipeline_pid
  local runtime_args=()

  status=0
  installer_root=""
  installer_identity=""
  installer_signal_status=0
  installer_pipeline_pid=""

  cleanup_installer_state() {
    if [[ -z "$installer_root" ]]; then
      return 0
    fi
    if [[ -n "$installer_identity" ]]; then
      manage_installer_scratch \
        cleanup "$installer_root" "$installer_identity"
    else
      manage_installer_scratch cleanup-empty "$installer_root"
    fi
  }

  cleanup_installer_state_on_exit() {
    local exit_status=$?
    trap - EXIT HUP INT TERM
    if [[ -n "$installer_pipeline_pid" ]]; then
      kill -TERM "$installer_pipeline_pid" 2>/dev/null || true
      wait "$installer_pipeline_pid" 2>/dev/null || true
      installer_pipeline_pid=""
    fi
    cleanup_status=0
    cleanup_installer_state || cleanup_status=$?
    if [[ "$cleanup_status" != 0 ]]; then
      echo "Failed to remove private internal installer scratch state." >&2
      if [[ "$exit_status" == 0 ]]; then
        exit_status="$cleanup_status"
      fi
    fi
    exit "$exit_status"
  }
  forward_installer_signal() {
    installer_signal_status="$1"
    if [[ -n "$installer_pipeline_pid" ]]; then
      kill "-$2" "$installer_pipeline_pid" 2>/dev/null || true
    fi
  }
  trap cleanup_installer_state_on_exit EXIT
  trap 'forward_installer_signal 129 HUP' HUP
  trap 'forward_installer_signal 130 INT' INT
  trap 'forward_installer_signal 143 TERM' TERM

  if installer_root="$(
    mktemp -d /tmp/codex-switch-internal-installer.XXXXXX
  )"; then
    true
  else
    status=$?
  fi
  if [[ "$status" == 0 ]]; then
    if chmod 700 "$installer_root"; then
      true
    else
      status=$?
    fi
  fi
  if [[ "$status" == 0 ]]; then
    if installer_identity="$(
      manage_installer_scratch identity "$installer_root"
    )"; then
      true
    else
      status=$?
    fi
  fi

  if [[ "$status" == 0 ]]; then
    if mkdir -m 700 "$installer_root/home" "$installer_root/codex-home"; then
      true
    else
      status=$?
    fi
  fi

  if [[ "$installer_signal_status" != 0 ]]; then
    status="$installer_signal_status"
  fi
  if [[ "$status" == 0 ]]; then
    set +e
    curl -fsSL "$INSTALLER_URL" |
      HOME="$installer_root/home" \
      CODEX_HOME="$installer_root/codex-home" \
      CODEX_NON_INTERACTIVE=1 \
      PATH="$INSTALL_DIR:$PATH" \
      CODEX_INSTALL_DIR="$INSTALL_DIR" \
      CODEX_INSTALL_MODEL="$INSTALL_MODEL" \
      CODEX_INSTALL_AK="$install_ak" \
      CODEX_INSTALL_AZURE_BASE_URL="$INSTALL_AZURE_BASE_URL" \
      bash -s -- "$INSTALL_VERSION" &
    installer_pipeline_pid=$!
    if [[ "$installer_signal_status" != 0 ]]; then
      kill -TERM "$installer_pipeline_pid" 2>/dev/null || true
    fi
    wait "$installer_pipeline_pid"
    status=$?
    if [[ "$installer_signal_status" != 0 ]]; then
      kill -TERM "$installer_pipeline_pid" 2>/dev/null || true
      wait "$installer_pipeline_pid" 2>/dev/null || true
    fi
    installer_pipeline_pid=""
    set -e
  fi
  if [[ "$installer_signal_status" != 0 ]]; then
    status="$installer_signal_status"
  fi

  if [[ "$status" == 0 && -L "$INSTALL_DIR/codex" ]]; then
    if [[ "$(uname -s)" == "Darwin" ]] && command -v codesign >/dev/null 2>&1; then
      runtime_args+=(--codesign)
    fi
    "$PYTHON_BIN" -I -B "$SCRIPT_DIR/codex_switch_internal_runtime.py" \
      --candidate "$INSTALL_DIR/codex" --scratch "$installer_root" \
      --version "$INSTALL_VERSION" "${runtime_args[@]}" >/dev/null &
    installer_pipeline_pid=$!
    if [[ "$installer_signal_status" != 0 ]]; then
      kill -TERM "$installer_pipeline_pid" 2>/dev/null || true
    fi
    if wait "$installer_pipeline_pid"; then
      INTERNAL_CANDIDATE_LAYOUT="standalone"
    else
      status=$?
    fi
    if [[ "$installer_signal_status" != 0 ]]; then
      kill -TERM "$installer_pipeline_pid" 2>/dev/null || true
      wait "$installer_pipeline_pid" 2>/dev/null || true
    fi
    installer_pipeline_pid=""
  fi

  cleanup_status=0
  cleanup_installer_state || cleanup_status=$?
  if [[ "$cleanup_status" != 0 ]]; then
    echo "Failed to remove private internal installer scratch state." >&2
    if [[ "$status" == 0 ]]; then
      status="$cleanup_status"
    fi
  fi
  installer_root=""
  if [[ "$installer_signal_status" != 0 ]]; then
    status="$installer_signal_status"
  fi
  trap - EXIT HUP INT TERM
  return "$status"
}

check_internal() {
  if [[ "$DRY_RUN" == 1 ]]; then
    echo "[DRY-RUN] would inspect internal Codex binary: $INTERNAL_BIN"
    echo "[DRY-RUN] would query latest release: $LATEST_URL"
    return
  fi

  echo "Internal Codex binary: $INTERNAL_BIN"
  if [[ ! -x "$INTERNAL_BIN" ]]; then
    echo "Current: <missing or not executable>"
  else
    local current
    current="$("$INTERNAL_BIN" --version 2>/dev/null || true)"
    echo "Current: ${current:-<unavailable>}"
  fi

  local tag latest_version current_version current
  local decision_payload decision target_version decision_reason
  if ! tag="$(latest_internal_tag)"; then
    echo "Latest release: <unavailable from $LATEST_URL>"
    return 1
  fi
  latest_version="$(printf '%s\n' "$tag" | extract_version)"
  current="$("$INTERNAL_BIN" --version 2>/dev/null || true)"
  current_version="$(printf '%s\n' "$current" | extract_version)"
  echo "Latest release tag: ${tag:-<unknown>}"
  if ! decision_payload="$(
    internal_update_decision "$current_version" "$latest_version"
  )"; then
    echo "Update: unable to compare versions (ordered policy unavailable)" >&2
    return 1
  fi
  IFS=$'\t' read -r decision target_version decision_reason <<<"$decision_payload"
  case "$decision" in
    upgrade)
      echo "Update: available (ordered upgrade to $target_version)"
      ;;
    newer_current)
      echo "Update: not needed (healthy current $current_version is newer than reported latest $latest_version)"
      ;;
    up_to_date)
      echo "Update: not needed"
      ;;
    *)
      echo "Update: unable to compare versions ($decision_reason)" >&2
      return 1
      ;;
  esac
}

verify_lark_install_source() {
  if [[ "$SKIP_SOURCE_CHECK" == 1 ]]; then
    echo "Skipping Lark install-source check."
    return
  fi
  if ! command -v lark-cli >/dev/null 2>&1; then
    echo "lark-cli not found; cannot verify the team Codex install source." >&2
    exit 1
  fi

  local tmp
  tmp="$(mktemp)"
  if ! lark-cli docs +fetch --api-version v2 \
    --doc "$TEAM_DOC_URL" \
    --scope keyword \
    --keyword "CLI 安装|CODEX_INSTALL|install.sh|codesign|CODEX_INSTALL_AZURE_BASE_URL" \
    --doc-format markdown \
    --format json >"$tmp"; then
    rm -f "$tmp"
    echo "Failed to fetch the team Codex CLI install source." >&2
    exit 1
  fi

  local missing=0
  for expected in \
    "$DEFAULT_INSTALLER_URL" \
    "CODEX_INSTALL_DIR" \
    "CODEX_INSTALL_MODEL" \
    "$DEFAULT_MODEL" \
    "CODEX_INSTALL_AK" \
    "CODEX_INSTALL_AZURE_BASE_URL" \
    "$DEFAULT_AZURE_BASE_URL" \
    "codesign --force --sign"; do
    if ! grep -Fq "$expected" "$tmp"; then
      echo "Team install source is missing expected token: $expected" >&2
      missing=1
    fi
  done
  rm -f "$tmp"
  if [[ "$missing" == 1 ]]; then
    echo "Codex install guidance appears to have drifted; aborting update." >&2
    exit 1
  fi
}

update_internal() {
  local install_bin
  local install_ak="${CODEX_INSTALL_AK:-${K_CODEX:-}}"
  local bound_identity candidate_identity observed_identity
  local candidate_output candidate_version candidate_status
  local installer_status codesign_status
  local old_https_proxy="${https_proxy-}" old_http_proxy="${http_proxy-}"
  local had_https_proxy=0 had_http_proxy=0

  if [[ -z "$INSTALL_VERSION" ]]; then
    echo "Internal staged update requires an explicit intended --version." >&2
    return 2
  fi
  if ! internal_install_version_is_valid "$INSTALL_VERSION"; then
    echo "Internal staged update version must be a semantic version: $INSTALL_VERSION" >&2
    return 2
  fi
  if INSTALL_DIR="$(validate_staged_candidate_request)"; then
    true
  else
    return $?
  fi
  install_bin="$INSTALL_DIR/codex"

  if [[ "$DRY_RUN" == 1 ]]; then
    echo "[DRY-RUN] would verify Lark install source: $TEAM_DOC_URL"
    echo "[DRY-RUN] Target version: $INSTALL_VERSION"
    echo "[DRY-RUN] Candidate path class: private sibling"
    echo "[DRY-RUN] Candidate install directory: $INSTALL_DIR"
    echo "[DRY-RUN] Bound binary remains unchanged: $INTERNAL_BIN"
    echo "[DRY-RUN] installer: $INSTALLER_URL"
    echo "[DRY-RUN] model: $INSTALL_MODEL"
    echo "[DRY-RUN] azure base URL: $INSTALL_AZURE_BASE_URL"
    echo "[DRY-RUN] CODEX_INSTALL_AK: <hidden>"
    echo "[DRY-RUN] would create the candidate directory with mode 0700"
    echo "[DRY-RUN] would code-sign the candidate before exact version validation"
    return
  fi

  if [[ -z "$install_ak" ]]; then
    echo "CODEX_INSTALL_AK or K_CODEX is required for internal Codex updates." >&2
    return 1
  fi

  verify_lark_install_source

  if ! mkdir -m 700 "$INSTALL_DIR"; then
    echo "Failed to create private internal candidate directory: $INSTALL_DIR" >&2
    return 1
  fi
  chmod 700 "$INSTALL_DIR"
  if candidate_identity="$(staged_candidate_directory_identity "$INSTALL_DIR")"; then
    true
  else
    return $?
  fi

  if bound_identity="$(bound_binary_identity "$INTERNAL_BIN")"; then
    true
  else
    return $?
  fi

  if [[ -n "${https_proxy+x}" ]]; then
    had_https_proxy=1
  fi
  if [[ -n "${http_proxy+x}" ]]; then
    had_http_proxy=1
  fi
  if [[ "$SKIP_PROXY" != 1 ]]; then
    export https_proxy="${https_proxy:-$INSTALL_PROXY_URL}"
    export http_proxy="${http_proxy:-$INSTALL_PROXY_URL}"
  fi

  echo "Staging internal Codex CLI via $INSTALLER_URL"
  if run_trusted_internal_installer "$install_ak"; then
    installer_status=0
  else
    installer_status=$?
  fi

  if [[ $had_https_proxy -eq 1 ]]; then
    export https_proxy="$old_https_proxy"
  else
    unset https_proxy
  fi
  if [[ $had_http_proxy -eq 1 ]]; then
    export http_proxy="$old_http_proxy"
  else
    unset http_proxy
  fi

  if assert_bound_binary_identity "$bound_identity" "during candidate install"; then
    true
  else
    return $?
  fi
  if [[ "$installer_status" != 0 ]]; then
    echo "Codex install.sh failed with exit $installer_status; bound binary was not modified." >&2
    return "$installer_status"
  fi

  if observed_identity="$(staged_candidate_directory_identity "$INSTALL_DIR")"; then
    true
  else
    return $?
  fi
  if [[ "$observed_identity" != "$candidate_identity" ]]; then
    echo "Internal candidate directory identity changed during install: $INSTALL_DIR" >&2
    return 1
  fi
  validate_staged_candidate_executable "$install_bin"

  codesign_status=0
  if [[ "$INTERNAL_CANDIDATE_LAYOUT" == "legacy" && "$(uname -s)" == "Darwin" ]] && command -v codesign >/dev/null 2>&1 && [[ -x "$install_bin" ]]; then
    if codesign --force --sign - "$install_bin" >/dev/null; then
      true
    else
      codesign_status=$?
    fi
  fi
  if assert_bound_binary_identity "$bound_identity" "during candidate code-sign"; then
    true
  else
    return $?
  fi
  if [[ "$codesign_status" != 0 ]]; then
    echo "Internal candidate code-sign failed with exit $codesign_status: $install_bin" >&2
    return "$codesign_status"
  fi
  if observed_identity="$(staged_candidate_directory_identity "$INSTALL_DIR")"; then
    true
  else
    return $?
  fi
  if [[ "$observed_identity" != "$candidate_identity" ]]; then
    echo "Internal candidate directory identity changed before validation: $INSTALL_DIR" >&2
    return 1
  fi
  validate_staged_candidate_executable "$install_bin"

  if candidate_output="$("$install_bin" --version 2>&1)"; then
    candidate_status=0
  else
    candidate_status=$?
  fi
  if assert_bound_binary_identity "$bound_identity" "during candidate version probe"; then
    true
  else
    return $?
  fi
  if [[ "$candidate_status" != 0 ]]; then
    echo "Internal candidate version probe failed with exit $candidate_status: $install_bin" >&2
    return "$candidate_status"
  fi
  if candidate_version="$(
    printf '%s\n' "$candidate_output" | strict_semantic_version_from_output
  )"; then
    true
  else
    candidate_version=""
  fi
  if [[ "$candidate_version" != "$INSTALL_VERSION" ]]; then
    echo "Internal candidate version mismatch: expected $INSTALL_VERSION but observed ${candidate_version:-<unparseable>}." >&2
    return 1
  fi
  echo "Internal Codex candidate ready: $install_bin"
  echo "Bound internal Codex remains unchanged: $INTERNAL_BIN"
}

check_official() {
  echo "Official ChatGPT.app Codex binary: $OFFICIAL_BIN"
  if [[ ! -x "$OFFICIAL_BIN" ]]; then
    echo "Current: <missing or not executable>"
    return 1
  fi
  echo "Current: $("$OFFICIAL_BIN" --version 2>/dev/null || echo "<unavailable>")"
  echo "Update: managed by ChatGPT.app."
}

desktop_guidance() {
  if [[ "$DRY_RUN" == 1 ]]; then
    echo "[DRY-RUN] would fetch Desktop install guidance from: $TEAM_DOC_URL"
    return
  fi

  if command -v lark-cli >/dev/null 2>&1; then
    lark-cli docs +fetch --api-version v2 \
      --doc "$TEAM_DOC_URL" \
      --scope keyword \
      --keyword "Desktop 安装|Codex Mac APP|LaunchAgent|remote-connections|Desktop" \
      --doc-format markdown \
      --format json || true
  else
    echo "lark-cli not found; printing local guidance only."
  fi
  cat <<'GUIDANCE'

ChatGPT Desktop guidance:
- Install or update the Codex CLI first.
- ChatGPT still requires OpenAI account login.
- Do not modify /Applications/ChatGPT.app manually.
- Use codex-switch set-app-bin <profile> <path> to persist CODEX_CLI_PATH.
- Restart ChatGPT after changing CODEX_CLI_PATH.
- Remote connection setup is out of scope unless explicitly requested.
GUIDANCE
}

install_wrapper() {
  echo "codex-env-setup is private to codex-switch. Install the public CLI with: codex-switch install" >&2
  exit 2
}

parse_common_option() {
  case "$1" in
    --first-install)
      FIRST_INSTALL=1
      return 1
      ;;
    --internal-bin)
      [[ $# -ge 2 ]] || { echo "--internal-bin requires a value" >&2; exit 2; }
      INTERNAL_BIN="$(expand_shell_path "$2")"
      return 2
      ;;
    --official-bin)
      [[ $# -ge 2 ]] || { echo "--official-bin requires a value" >&2; exit 2; }
      OFFICIAL_BIN="$(expand_shell_path "$2")"
      return 2
      ;;
    --install-dir)
      [[ $# -ge 2 ]] || { echo "--install-dir requires a value" >&2; exit 2; }
      INSTALL_DIR="$(expand_shell_path "$2")"
      INSTALL_DIR_EXPLICIT=1
      return 2
      ;;
    --installer-url)
      [[ $# -ge 2 ]] || { echo "--installer-url requires a value" >&2; exit 2; }
      INSTALLER_URL="$2"
      return 2
      ;;
    --latest-url)
      [[ $# -ge 2 ]] || { echo "--latest-url requires a value" >&2; exit 2; }
      LATEST_URL="$2"
      return 2
      ;;
    --version|--codex-install-version)
      [[ $# -ge 2 ]] || { echo "$1 requires a value" >&2; exit 2; }
      INSTALL_VERSION="$2"
      return 2
      ;;
    --model)
      [[ $# -ge 2 ]] || { echo "--model requires a value" >&2; exit 2; }
      INSTALL_MODEL="$2"
      return 2
      ;;
    --azure-base-url|--codex-install-base-url)
      [[ $# -ge 2 ]] || { echo "$1 requires a value" >&2; exit 2; }
      INSTALL_AZURE_BASE_URL="$2"
      return 2
      ;;
    --skip-source-check)
      SKIP_SOURCE_CHECK=1
      return 1
      ;;
    --skip-proxy|--skip-codex-install-proxy)
      SKIP_PROXY=1
      return 1
      ;;
    --dry-run)
      DRY_RUN=1
      return 1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      return 0
      ;;
  esac
}

while (($#)); do
  parse_common_option "$@" || consumed=$?
  consumed="${consumed:-0}"
  if [[ "$consumed" == 0 ]]; then
    break
  fi
  shift "$consumed"
  unset consumed
done

cmd="${1:-}"
if [[ -z "$cmd" ]]; then
  usage
  exit 2
fi
shift

while (($#)); do
  parse_common_option "$@" || consumed=$?
  consumed="${consumed:-0}"
  if [[ "$consumed" == 0 ]]; then
    echo "Unknown option for $cmd: $1" >&2
    exit 2
  fi
  shift "$consumed"
  unset consumed
done

case "$cmd" in
  check-internal)
    check_internal
    ;;
  update-internal)
    update_internal
    ;;
  check-official)
    check_official
    ;;
  desktop-guidance)
    desktop_guidance
    ;;
  install)
    install_wrapper
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
