#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
SWITCH_PY="${CODEX_SWITCH_SCRIPT:-$SCRIPT_DIR/codex_profile_switch.py}"
VERSION_FILE="$SCRIPT_DIR/../VERSION"
CODEX_SWITCH_VERSION="${CODEX_SWITCH_VERSION:-}"
ORIGINAL_ARGS=("$@")

PYTHON_BIN="${CODEX_SWITCH_PYTHON:-}"
PYTHON_BIN_EXPLICIT=0
PYTHON_BIN_RESOLVED=0
[[ -n "$PYTHON_BIN" ]] && PYTHON_BIN_EXPLICIT=1

STORE_DIR="${CODEX_SWITCH_HOME:-$HOME/.codex-switch}"
REPO_TARBALL_BASE="https://github.com/cYz26/codex-switch/releases"
REPO_SOURCE_BASE="https://github.com/cYz26/codex-switch/archive"
LIB_DIR="${CODEX_SWITCH_LIB_DIR:-$HOME/.local/share/codex-switch}"
SELF_UPDATE_SOURCE_DIR="${CODEX_SWITCH_SOURCE_DIR:-}"
SELF_UPDATE_TARBALL_URL="${CODEX_SWITCH_SELF_UPDATE_TARBALL_URL:-${CODEX_SWITCH_TARBALL_URL:-}}"
SELF_UPDATE_SOURCE_TARBALL_URL="${CODEX_SWITCH_SELF_UPDATE_SOURCE_TARBALL_URL:-${CODEX_SWITCH_SOURCE_TARBALL_URL:-}}"
SELF_UPDATE_VERSION="${CODEX_SWITCH_SELF_UPDATE_VERSION:-${CODEX_SWITCH_VERSION:-}}"
SELF_UPDATE_PROXY_URL="${CODEX_SWITCH_GITHUB_PROXY:-}"
SKIP_SELF_UPDATE=0
GLOBAL_ARGS=()
SPLIT_KEEP_VERSION=0
SPLIT_APP_PROFILE_OVERRIDE=0
SPLIT_COMMAND_ARGS=()
LAST_SWITCH_APP_ACTION=""

usage() {
  cat <<'USAGE'
Usage:
  codex-switch [global options] <command> [command options]

One-key commands:
  internal                 Auto-update internal CLI if needed, then switch.
  split                    Use internal CLI with the official App and synchronize shared state.
  official                 Switch to the official profile after a dry-run plan.
  check-update [profile]   Read-only Codex CLI update check.
  update-internal          Install or update the internal Codex CLI.
  env <command>            Run Codex workstation environment helper commands.
  install                  Symlink this wrapper to ~/.local/bin/codex-switch.
  version                  Print codex-switch version.

Pass-through commands:
  init | capture | switch | restore | status | list | doctor | repair-plugins | sync-shared | verify | shim-env
  login-internal | login-official
  login | set-bin | set-app-bin
  raw <codex_profile_switch.py args...>

Global options:
  --store-dir <path>           Profile store. Default: ~/.codex-switch.
  --official-codex-home <path> Official Codex home. Default: ~/.codex.
  --live-codex-home <path>     Legacy alias for --official-codex-home.
  --internal-codex-home <path> Internal Codex home. Default: ~/.codex-switch/homes/internal.
  --launch-agent-path <path>   LaunchAgent plist path.
  --launch-agent-label <name>  LaunchAgent label.
  --skip-self-update           Do not sync installed codex-switch scripts.

Switch options for internal/split/official:
  --keep-version              Split only: skip codex-switch and internal updates.
  --app-profile <profile>      Select a distinct App profile. Supported split: internal CLI + official App.
  --dry-run                    Only print the switch and shared-readiness plan.
  --snapshot                   Use whole-file config snapshot mode.
  --shared-config-base <name>  Rebuild shared config from a stored profile.
  --skip-launchctl             Write LaunchAgent but do not call launchctl.
  --skip-app-cli               Do not update ChatGPT Desktop CODEX_CLI_PATH.
  --skip-shim                  Do not update the codex shim.
  --skip-login                 Do not auto-login official when file auth is missing.
  --skip-update-check          Do not check for updates or auto-update internal.
  --skip-plugin-repair         Do not install missing or refresh stale enabled plugins.
  --skip-verify                Do not verify the target profile after switch.
  --app-server-smoke           During verify, run target app-server startup smoke.
  --runtime-smoke              During verify, run target codex local runtime smoke.
  --exec-smoke <prompt>        During verify, run explicit codex exec --json smoke.
  --responses-tool-smoke       During verify, run deterministic Responses tool-follow-up smoke.
  --verification-report        Write a JSON verification report during verify.
  --no-status                  Do not print status after a real switch.
  --skip-doctor                Do not run doctor after a real switch.

Examples:
  codex-switch internal
  codex-switch split
  codex-switch split --keep-version
  codex-switch internal --app-profile official
  codex-switch sync-shared --dry-run
  codex-switch official --dry-run
  codex-switch check-update
  codex-switch update-internal --dry-run
  codex-switch env check-internal
  eval "$(codex-switch shim-env)"
USAGE
}

expand_shell_path() {
  local raw="$1"
  case "$raw" in
    "~") printf '%s\n' "$HOME" ;;
    "~/"*) printf '%s/%s\n' "$HOME" "${raw#~/}" ;;
    *) printf '%s\n' "$raw" ;;
  esac
}

truthy() {
  case "${1:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

normalize_split_command_args() {
  local arg expects_value=0 passthrough=0
  SPLIT_KEEP_VERSION=0
  SPLIT_APP_PROFILE_OVERRIDE=0
  SPLIT_COMMAND_ARGS=()
  while (($#)); do
    arg="$1"
    shift
    if [[ "$passthrough" == 1 ]]; then
      SPLIT_COMMAND_ARGS+=("$arg")
      continue
    fi
    if [[ "$expects_value" == 1 ]]; then
      SPLIT_COMMAND_ARGS+=("$arg")
      expects_value=0
      continue
    fi
    if [[ "$expects_value" == 2 ]]; then
      expects_value=0
      continue
    fi
    case "$arg" in
      --keep-version)
        SPLIT_KEEP_VERSION=1
        ;;
      --app-profile)
        SPLIT_APP_PROFILE_OVERRIDE=1
        expects_value=2
        ;;
      --app-profile=*)
        SPLIT_APP_PROFILE_OVERRIDE=1
        ;;
      --shared-config-base|--config-mode|--exec-smoke)
        SPLIT_COMMAND_ARGS+=("$arg")
        expects_value=1
        ;;
      --)
        SPLIT_COMMAND_ARGS+=("$arg")
        passthrough=1
        ;;
      *)
        SPLIT_COMMAND_ARGS+=("$arg")
        ;;
    esac
  done
  if [[ "$SPLIT_KEEP_VERSION" == 1 ]]; then
    SPLIT_COMMAND_ARGS+=(--skip-update-check)
  fi
}

split_preview_requested() {
  local command="$1"
  shift
  local arg app_profile="" dry_run=0 expects_value="" passthrough=0
  case "$command" in
    split|internal|i) ;;
    *) return 1 ;;
  esac
  while (($#)); do
    arg="$1"
    shift
    if [[ "$passthrough" == 1 ]]; then
      continue
    fi
    if [[ -n "$expects_value" ]]; then
      if [[ "$expects_value" == "app-profile" ]]; then
        app_profile="$arg"
      fi
      expects_value=""
      continue
    fi
    case "$arg" in
      --dry-run)
        dry_run=1
        ;;
      --app-profile)
        expects_value="app-profile"
        ;;
      --app-profile=*)
        app_profile="${arg#--app-profile=}"
        ;;
      --shared-config-base|--config-mode|--exec-smoke)
        expects_value="ignored"
        ;;
      --)
        passthrough=1
        ;;
    esac
  done
  [[ "$dry_run" == 1 ]] || return 1
  if [[ "$command" == "split" ]]; then
    return 0
  fi
  is_official_profile_alias "$app_profile"
}

python_candidate_path() {
  local candidate="$1"
  if [[ "$candidate" == */* ]]; then
    [[ -x "$candidate" ]] || return 1
    printf '%s\n' "$candidate"
    return
  fi
  command -v "$candidate" 2>/dev/null
}

python_supports_config_document() {
  local candidate="$1"
  "$candidate" -c \
    'import sys, tomllib; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' \
    >/dev/null 2>&1
}

resolve_python_bin() {
  local raw candidate resolved seen
  local candidates=(
    python3
    python3.13
    python3.12
    python3.11
    /opt/homebrew/bin/python3
    /opt/homebrew/bin/python3.13
    /opt/homebrew/bin/python3.12
    /opt/homebrew/bin/python3.11
    /usr/local/bin/python3
    /usr/local/bin/python3.13
    /usr/local/bin/python3.12
    /usr/local/bin/python3.11
  )
  if [[ "$PYTHON_BIN_RESOLVED" == 1 ]]; then
    return 0
  fi
  if [[ "$PYTHON_BIN_EXPLICIT" == 1 ]]; then
    raw="$PYTHON_BIN"
    if ! resolved="$(python_candidate_path "$raw")" \
      || ! python_supports_config_document "$resolved"; then
      echo "CODEX_SWITCH_PYTHON must resolve to Python 3.11+ with tomllib: $raw" >&2
      return 1
    fi
  else
    resolved=""
    seen="|"
    for raw in "${candidates[@]}"; do
      candidate="$(python_candidate_path "$raw" || true)"
      [[ -n "$candidate" ]] || continue
      case "$seen" in
        *"|$candidate|"*) continue ;;
      esac
      seen="${seen}${candidate}|"
      if python_supports_config_document "$candidate"; then
        resolved="$candidate"
        break
      fi
    done
    if [[ -z "$resolved" ]]; then
      echo "Python 3.11+ with tomllib not found; set CODEX_SWITCH_PYTHON to a valid interpreter" >&2
      return 1
    fi
  fi
  PYTHON_BIN="$resolved"
  PYTHON_BIN_RESOLVED=1
  export CODEX_SWITCH_PYTHON="$PYTHON_BIN"
}

self_update_lib_dir() {
  expand_shell_path "$LIB_DIR"
}

self_update_release_script_dir() {
  printf '%s\n' "$(self_update_lib_dir)/current/scripts"
}

is_release_installed_wrapper() {
  local expected
  expected="$(self_update_release_script_dir)"
  [[ -d "$expected" ]] || return 1
  expected="$(cd -P "$expected" && pwd)"
  [[ "$SCRIPT_DIR" == "$expected" ]]
}

self_update_tarball_url() {
  if [[ -n "$SELF_UPDATE_TARBALL_URL" ]]; then
    printf '%s\n' "$SELF_UPDATE_TARBALL_URL"
  elif [[ -n "$SELF_UPDATE_VERSION" ]]; then
    printf '%s/download/%s/codex-switch.tar.gz\n' "$REPO_TARBALL_BASE" "$SELF_UPDATE_VERSION"
  else
    printf '%s/latest/download/codex-switch.tar.gz\n' "$REPO_TARBALL_BASE"
  fi
}

self_update_source_tarball_url() {
  if [[ -n "$SELF_UPDATE_SOURCE_TARBALL_URL" ]]; then
    printf '%s\n' "$SELF_UPDATE_SOURCE_TARBALL_URL"
  elif [[ -n "$SELF_UPDATE_VERSION" ]]; then
    printf '%s/refs/tags/%s.tar.gz\n' "$REPO_SOURCE_BASE" "$SELF_UPDATE_VERSION"
  fi
}

bundle_version() {
  local root="$1"
  if [[ -f "$root/VERSION" ]]; then
    sed -n '1p' "$root/VERSION"
  fi
}

version_core() {
  local version="${1#v}"
  version="${version%%+*}"
  version="${version%%-*}"
  printf '%s\n' "$version"
}

version_prerelease() {
  local version="${1#v}"
  version="${version%%+*}"
  if [[ "$version" == *-* ]]; then
    printf '%s\n' "${version#*-}"
  fi
}

version_is_semver() {
  local version="${1#v}"
  [[
    "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$
  ]]
}

version_is_newer() {
  local current="$1"
  local candidate="$2"
  local current_core candidate_core current_pre candidate_pre
  local current_part candidate_part i
  current_core="$(version_core "$current")"
  candidate_core="$(version_core "$candidate")"
  current_pre="$(version_prerelease "$current")"
  candidate_pre="$(version_prerelease "$candidate")"

  IFS=. read -r -a current_parts <<< "$current_core"
  IFS=. read -r -a candidate_parts <<< "$candidate_core"
  for i in 0 1 2; do
    current_part="${current_parts[$i]:-0}"
    candidate_part="${candidate_parts[$i]:-0}"
    [[ "$current_part" =~ ^[0-9]+$ ]] || return 0
    [[ "$candidate_part" =~ ^[0-9]+$ ]] || return 0
    if ((10#$candidate_part > 10#$current_part)); then
      return 0
    fi
    if ((10#$candidate_part < 10#$current_part)); then
      return 1
    fi
  done

  if [[ -n "$current_pre" && -z "$candidate_pre" ]]; then
    return 0
  fi
  if [[ -z "$current_pre" && -n "$candidate_pre" ]]; then
    return 1
  fi
  [[ -n "$current_pre" && -n "$candidate_pre" && "$candidate_pre" > "$current_pre" ]]
}

SELF_UPDATE_ACTIVE_ROOT=""
SELF_UPDATE_ACTIVE_VERSION=""
SELF_UPDATE_ACTIVE_DIGEST=""
SELF_UPDATE_TRUSTED_VERSION=""

self_update_uses_default_latest() {
  [[
    -z "$SELF_UPDATE_SOURCE_DIR"
    && -z "$SELF_UPDATE_TARBALL_URL"
    && -z "$SELF_UPDATE_SOURCE_TARBALL_URL"
    && -z "$SELF_UPDATE_VERSION"
  ]]
}

resolve_trusted_self_update_version() {
  local latest_tag=""
  SELF_UPDATE_TRUSTED_VERSION=""
  if [[ -n "$SELF_UPDATE_VERSION" ]]; then
    if version_is_semver "$SELF_UPDATE_VERSION"; then
      SELF_UPDATE_TRUSTED_VERSION="${SELF_UPDATE_VERSION#v}"
      return 0
    fi
    return 2
  fi
  if ! self_update_uses_default_latest; then
    return 2
  fi
  if [[ -n "$SELF_UPDATE_PROXY_URL" ]]; then
    export https_proxy="${https_proxy:-$SELF_UPDATE_PROXY_URL}"
    export http_proxy="${http_proxy:-$SELF_UPDATE_PROXY_URL}"
  fi
  if latest_tag="$(
    latest_release_tag_from_url "$REPO_TARBALL_BASE/latest" 10
  )"; then
    :
  else
    echo "codex-switch self-update: could not resolve latest release version" >&2
    return 1
  fi
  if ! version_is_semver "$latest_tag"; then
    echo "codex-switch self-update: latest release tag is not semantic: ${latest_tag:-<empty>}" >&2
    return 1
  fi
  SELF_UPDATE_VERSION="$latest_tag"
  SELF_UPDATE_TRUSTED_VERSION="${latest_tag#v}"
}

self_update_version_gate() {
  local lib_dir="$1"
  local current_version="" resolve_status=0
  current_version="$(bundle_version "$lib_dir/current")"
  [[ -n "$current_version" ]] || return 0
  if resolve_trusted_self_update_version; then
    :
  else
    resolve_status=$?
    if [[ "$resolve_status" -eq 2 ]]; then
      return 0
    fi
    return "$resolve_status"
  fi
  if [[ "$current_version" == "$SELF_UPDATE_TRUSTED_VERSION" ]] \
    || ! version_is_newer "$current_version" "$SELF_UPDATE_TRUSTED_VERSION"; then
    echo "codex-switch self-update: already up to date $current_version" >&2
    return 3
  fi
}

self_update_trusted_modules_ready() {
  local module
  for module in codex_switch_release_bundle.py codex_switch_promotion.py; do
    if [[ ! -f "$SCRIPT_DIR/$module" || -L "$SCRIPT_DIR/$module" ]]; then
      echo "codex-switch self-update: trusted module is unavailable: $SCRIPT_DIR/$module" >&2
      return 1
    fi
  done
}

create_self_update_workdir() {
  local lib_dir="" workdir=""
  lib_dir="$(self_update_lib_dir)"
  if ! mkdir -p "$lib_dir"; then
    echo "codex-switch self-update: could not create library directory: $lib_dir" >&2
    return 1
  fi
  if ! workdir="$(mktemp -d "$lib_dir/.self-update.XXXXXX")"; then
    echo "codex-switch self-update: could not create candidate staging directory" >&2
    return 1
  fi
  printf '%s\n' "$workdir"
}

cleanup_self_update_workdir() {
  local workdir="$1"
  local lib_dir=""
  lib_dir="$(self_update_lib_dir)"
  if [[ "$workdir" != "$lib_dir"/.self-update.* ]]; then
    echo "codex-switch self-update: refusing to clean unowned staging: $workdir" >&2
    return 1
  fi
  if ! rm -rf "$workdir"; then
    echo "codex-switch self-update: could not clean candidate staging: $workdir" >&2
    return 1
  fi
}

stage_self_update_from_source() {
  local source_dir="$1"
  local staged="$2"
  if [[
    ! -d "$source_dir"
    || -L "$source_dir"
    || ! -f "$source_dir/scripts/codex-switch"
    || -L "$source_dir/scripts/codex-switch"
    || ! -x "$source_dir/scripts/codex-switch"
  ]]; then
    echo "codex-switch self-update: invalid source directory: $source_dir" >&2
    return 1
  fi
  if ! rm -rf "$staged"; then
    return 1
  fi
  if ! mkdir -p "$(dirname "$staged")"; then
    return 1
  fi
  if ! cp -pR "$source_dir" "$staged"; then
    return 1
  fi
  if ! rm -rf "$staged/scripts/__pycache__"; then
    return 1
  fi
}

validate_self_update_downloaded_source() {
  local source_dir="$1"
  local path

  for path in README.md SKILL.md VERSION run.sh; do
    if [[ ! -f "$source_dir/$path" || -L "$source_dir/$path" ]]; then
      echo "codex-switch self-update: downloaded source is missing required file: $path" >&2
      return 1
    fi
  done
  for path in agents docs evals scripts; do
    if [[ ! -d "$source_dir/$path" || -L "$source_dir/$path" ]]; then
      echo "codex-switch self-update: downloaded source is missing required directory: $path" >&2
      return 1
    fi
  done
  for path in run.sh scripts/codex-switch scripts/package-release.sh; do
    if [[ ! -f "$source_dir/$path" || -L "$source_dir/$path" || ! -x "$source_dir/$path" ]]; then
      echo "codex-switch self-update: downloaded source is missing required executable: $path" >&2
      return 1
    fi
  done
}

stage_self_update_from_downloaded_source() {
  local source_dir="$1"
  local staged="$2"
  local path

  if ! rm -rf "$staged"; then
    return 1
  fi
  if ! validate_self_update_downloaded_source "$source_dir"; then
    return 1
  fi
  if ! mkdir -p "$(dirname "$staged")" "$staged"; then
    if ! rm -rf "$staged"; then
      echo "codex-switch self-update: could not clean source staging: $staged" >&2
    fi
    return 1
  fi
  for path in README.md SKILL.md VERSION run.sh agents docs evals scripts; do
    if ! cp -pR "$source_dir/$path" "$staged/"; then
      if ! rm -rf "$staged"; then
        echo "codex-switch self-update: could not clean source staging: $staged" >&2
      fi
      return 1
    fi
  done
  if ! rm -rf "$staged/scripts/__pycache__"; then
    if ! rm -rf "$staged"; then
      echo "codex-switch self-update: could not clean source staging: $staged" >&2
    fi
    return 1
  fi
}

resolve_self_update_archive_source() {
  local tmp="$1"
  local candidate="" entry
  local count=0

  if [[ -d "$tmp/codex-switch" && ! -L "$tmp/codex-switch" ]]; then
    printf '%s\n' "$tmp/codex-switch"
    return 0
  fi
  for entry in "$tmp"/*; do
    if [[ ! -e "$entry" && ! -L "$entry" ]]; then
      continue
    fi
    if [[ -d "$entry" && ! -L "$entry" ]]; then
      candidate="$entry"
      count=$((count + 1))
    fi
  done
  if [[ "$count" -ne 1 ]]; then
    echo "codex-switch self-update: downloaded archive must contain exactly one source directory" >&2
    return 1
  fi
  printf '%s\n' "$candidate"
}

stage_self_update_archive_url() {
  local url="$1"
  local staged="$2"
  local mode="$3"
  local tmp="" src="" tar_options="" status=0 cleanup_status=0
  if ! tmp="$(mktemp -d)"; then
    echo "codex-switch self-update: could not create archive staging directory" >&2
    return 1
  fi
  tar_options="-xpzf"

  if [[ -n "$SELF_UPDATE_PROXY_URL" ]]; then
    export https_proxy="${https_proxy:-$SELF_UPDATE_PROXY_URL}"
    export http_proxy="${http_proxy:-$SELF_UPDATE_PROXY_URL}"
  fi

  status=0
  if curl -fsSL "$url" -o "$tmp/codex-switch.tar.gz"; then
    :
  else
    status=$?
  fi
  if [[ "$status" -eq 0 ]]; then
    if tar "$tar_options" "$tmp/codex-switch.tar.gz" -C "$tmp"; then
      :
    else
      status=$?
    fi
  fi
  if [[ "$status" -eq 0 ]]; then
    if src="$(resolve_self_update_archive_source "$tmp")"; then
      :
    else
      status=$?
    fi
  fi
  if [[ "$status" -eq 0 && ( -z "$src" || ! -x "$src/scripts/codex-switch" ) ]]; then
    echo "codex-switch self-update: downloaded archive does not contain scripts/codex-switch" >&2
    status=1
  fi
  if [[ "$status" -eq 0 ]]; then
    if [[ "$mode" == "source" ]]; then
      if stage_self_update_from_downloaded_source "$src" "$staged"; then
        :
      else
        status=$?
      fi
    elif stage_self_update_from_source "$src" "$staged"; then
      :
    else
      status=$?
    fi
  fi

  cleanup_status=0
  if rm -rf "$tmp"; then
    :
  else
    cleanup_status=$?
  fi
  if [[ "$status" -ne 0 ]]; then
    return "$status"
  fi
  return "$cleanup_status"
}

stage_self_update_from_tarball() {
  local staged="$1"
  local tarball_url source_url
  tarball_url="$(self_update_tarball_url)"

  if stage_self_update_archive_url "$tarball_url" "$staged" "bundle"; then
    return
  fi

  source_url="$(self_update_source_tarball_url)"
  if [[ -n "$source_url" ]]; then
    echo "codex-switch self-update: release bundle unavailable; trying source archive fallback" >&2
    if stage_self_update_archive_url "$source_url" "$staged" "source"; then
      return
    fi
  fi

  return 1
}

canonicalize_self_update_candidate() {
  local source_root="$1"
  local workdir="$2"
  local output_root="$workdir/bundle"

  if [[
    -f "$source_root/bundle-manifest.json"
    && ! -L "$source_root/bundle-manifest.json"
  ]]; then
    printf '%s\n' "$source_root"
    return 0
  fi
  if ! "$PYTHON_BIN" -B "$SCRIPT_DIR/codex_switch_release_bundle.py" \
    --repo-root "$source_root" \
    --output-root "$output_root" >/dev/null; then
    return 1
  fi
  printf '%s\n' "$output_root/codex-switch"
}

validate_self_update_candidate() {
  local candidate_root="$1"
  local expected_version="$2"
  "$PYTHON_BIN" -I -B -c '
import sys
from pathlib import Path

scripts_dir = Path(sys.argv[1])
candidate_root = Path(sys.argv[2])
expected_version = sys.argv[3] or None
sys.path.insert(0, str(scripts_dir))
from codex_switch_promotion import PromotionError, validate_candidate

try:
    candidate = validate_candidate(
        candidate_root,
        expected_version=expected_version,
    )
except PromotionError as error:
    print(
        f"codex-switch self-update: candidate validation failed "
        f"({error.reason}): {error}",
        file=sys.stderr,
    )
    raise SystemExit(1)
print(
    "\t".join(
        (
            candidate.version,
            candidate.digest,
            str(candidate.root),
        )
    )
)
' "$SCRIPT_DIR" "$candidate_root" "$expected_version"
}

parse_self_update_promotion_receipt() {
  local receipt="$1"
  local lib_dir="$2"
  local expected_version="$3"
  local expected_digest="$4"
  "$PYTHON_BIN" -I -B -c '
import json
import os
import sys
from pathlib import Path

try:
    payload = json.loads(sys.argv[1])
except json.JSONDecodeError as error:
    print(
        f"codex-switch self-update: promotion receipt is invalid: {error}",
        file=sys.stderr,
    )
    raise SystemExit(1)
if not isinstance(payload, dict) or payload.get("outcome") != "promoted":
    print(
        "codex-switch self-update: promotion receipt outcome is invalid",
        file=sys.stderr,
    )
    raise SystemExit(1)
run_id = payload.get("run_id")
version = payload.get("version")
digest = payload.get("digest")
raw_root = payload.get("active_root")
if (
    not isinstance(run_id, str)
    or not run_id
    or version != sys.argv[3]
    or digest != sys.argv[4]
    or not isinstance(raw_root, str)
    or not raw_root
):
    print(
        "codex-switch self-update: promotion receipt fields are invalid",
        file=sys.stderr,
    )
    raise SystemExit(1)
layout = Path(os.path.abspath(os.path.expanduser(sys.argv[2])))
active_root = Path(raw_root)
expected_root = layout / "releases" / digest
if (
    active_root.is_symlink()
    or not active_root.is_dir()
    or active_root.resolve() != expected_root.resolve()
    or (active_root / "VERSION").read_text().strip() != version
):
    print(
        "codex-switch self-update: promotion receipt root is invalid",
        file=sys.stderr,
    )
    raise SystemExit(1)
print("\t".join((str(active_root.resolve()), version, digest, run_id)))
' "$receipt" "$lib_dir" "$expected_version" "$expected_digest"
}

promote_self_update_candidate() {
  local candidate_root="$1"
  local candidate_version="$2"
  local candidate_digest="$3"
  local lib_dir="" receipt="" parsed="" active_root=""
  local receipt_version="" receipt_digest="" run_id=""
  local -a command
  lib_dir="$(self_update_lib_dir)"
  command=(
    "$PYTHON_BIN"
    -B
    "$SCRIPT_DIR/codex_switch_promotion.py"
    --candidate-root "$candidate_root"
    --layout-root "$lib_dir"
    --expected-version "$candidate_version"
  )
  if receipt="$("${command[@]}")"; then
    :
  else
    return $?
  fi
  if parsed="$(parse_self_update_promotion_receipt \
    "$receipt" \
    "$lib_dir" \
    "$candidate_version" \
    "$candidate_digest")"; then
    :
  else
    return $?
  fi
  IFS=$'\t' read -r active_root receipt_version receipt_digest run_id <<< "$parsed"
  if [[
    -z "$active_root"
    || -z "$run_id"
    || "$receipt_version" != "$candidate_version"
    || "$receipt_digest" != "$candidate_digest"
  ]]; then
    echo "codex-switch self-update: promotion receipt is incomplete" >&2
    return 1
  fi
  SELF_UPDATE_ACTIVE_ROOT="$active_root"
  SELF_UPDATE_ACTIVE_VERSION="$receipt_version"
  SELF_UPDATE_ACTIVE_DIGEST="$receipt_digest"
}

sync_self_update() {
  local lib_dir="" workdir="" source_root="" candidate_root="" candidate_info=""
  local current_version="" next_version="" next_digest="" validated_root=""
  local expected_version="" status=0 cleanup_status=0 gate_status=0
  SELF_UPDATE_ACTIVE_ROOT=""
  SELF_UPDATE_ACTIVE_VERSION=""
  SELF_UPDATE_ACTIVE_DIGEST=""
  lib_dir="$(self_update_lib_dir)"
  if self_update_version_gate "$lib_dir"; then
    :
  else
    gate_status=$?
    return "$gate_status"
  fi
  if ! resolve_python_bin; then
    return 1
  fi
  if ! self_update_trusted_modules_ready; then
    return 1
  fi
  if ! workdir="$(create_self_update_workdir)"; then
    return 1
  fi
  source_root="$workdir/source"
  status=0

  if [[ -n "$SELF_UPDATE_SOURCE_DIR" ]]; then
    if stage_self_update_from_source \
      "$(expand_shell_path "$SELF_UPDATE_SOURCE_DIR")" \
      "$source_root"; then
      :
    else
      status=$?
    fi
  elif stage_self_update_from_tarball "$source_root"; then
    :
  else
    status=$?
  fi

  if [[ "$status" -eq 0 ]]; then
    if candidate_root="$(canonicalize_self_update_candidate \
      "$source_root" \
      "$workdir")"; then
      :
    else
      status=$?
    fi
  fi
  expected_version="${SELF_UPDATE_VERSION#v}"
  if [[ "$status" -eq 0 ]]; then
    if candidate_info="$(validate_self_update_candidate \
      "$candidate_root" \
      "$expected_version")"; then
      IFS=$'\t' read -r next_version next_digest validated_root <<< "$candidate_info"
    else
      status=$?
    fi
  fi
  if [[
    "$status" -eq 0
    && (
      -z "$next_version"
      || -z "$next_digest"
      || -z "$validated_root"
    )
  ]]; then
    echo "codex-switch self-update: candidate validation result is incomplete" >&2
    status=1
  fi

  current_version="$(bundle_version "$lib_dir/current")"
  if [[ "$status" -eq 0 && -n "$current_version" ]]; then
    if [[ "$current_version" == "$next_version" ]] \
      || ! version_is_newer "$current_version" "$next_version"; then
      echo "codex-switch self-update: already up to date $current_version" >&2
      status=3
    fi
  fi
  if [[ "$status" -eq 0 ]]; then
    if promote_self_update_candidate \
      "$validated_root" \
      "$next_version" \
      "$next_digest"; then
      echo "codex-switch self-update: synced implementation ${current_version:-<unknown>} -> $next_version" >&2
    else
      status=$?
    fi
  fi

  cleanup_status=0
  if cleanup_self_update_workdir "$workdir"; then
    :
  else
    cleanup_status=$?
  fi
  if [[ "$status" -eq 0 && "$cleanup_status" -ne 0 ]]; then
    echo "codex-switch self-update: warning: promoted successfully but staging cleanup failed" >&2
  elif [[ "$status" -ne 0 && "$cleanup_status" -ne 0 ]]; then
    echo "codex-switch self-update: warning: failed to clean staging after update failure" >&2
  fi
  return "$status"
}

command_skips_self_update() {
  case "$1" in
    -h|--help|help|version|--version|-v|install|shim-env|sync-shared) return 0 ;;
    *) return 1 ;;
  esac
}

maybe_self_update() {
  local cmd="$1"
  local sync_status=0 exec_status=0

  if [[ "$SKIP_SELF_UPDATE" == 1 ]] || truthy "${CODEX_SWITCH_SKIP_SELF_UPDATE:-}"; then
    return 0
  fi
  if truthy "${CODEX_SWITCH_SELF_UPDATE_REEXECED:-}"; then
    return 0
  fi
  if command_skips_self_update "$cmd"; then
    return 0
  fi
  if ! is_release_installed_wrapper; then
    return 0
  fi

  echo "codex-switch self-update: checking latest release..." >&2
  if sync_self_update; then
    if [[
      -z "$SELF_UPDATE_ACTIVE_ROOT"
      || ! -x "$SELF_UPDATE_ACTIVE_ROOT/scripts/codex-switch"
    ]]; then
      echo "codex-switch self-update: warning: promotion returned no runnable root; continuing with current implementation" >&2
      return 0
    fi
    export CODEX_SWITCH_SELF_UPDATE_REEXECED=1
    export CODEX_SWITCH_SKIP_SELF_UPDATE=1
    exec "$SELF_UPDATE_ACTIVE_ROOT/scripts/codex-switch" "${ORIGINAL_ARGS[@]}" || {
      exec_status=$?
      echo "codex-switch self-update: failed to execute promoted implementation: $SELF_UPDATE_ACTIVE_ROOT" >&2
      return "$exec_status"
    }
  else
    sync_status=$?
    if [[ "$sync_status" != 3 ]]; then
      echo "codex-switch self-update: warning: sync failed; continuing with current implementation" >&2
    fi
  fi
}

run_switcher() {
  resolve_python_bin
  if ((${#GLOBAL_ARGS[@]})); then
    "$PYTHON_BIN" -u -B "$SWITCH_PY" "${GLOBAL_ARGS[@]}" "$@"
  else
    "$PYTHON_BIN" -u -B "$SWITCH_PY" "$@"
  fi
}

is_official_profile_alias() {
  case "$1" in
    official|openai|openai-official|o) return 0 ;;
    *) return 1 ;;
  esac
}

normalize_profile() {
  case "$1" in
    internal|i) printf '%s\n' "internal" ;;
    *)
      if is_official_profile_alias "$1"; then
        printf '%s\n' "openai-official"
      else
        echo "Unknown profile alias: $1" >&2
        exit 2
      fi
      ;;
  esac
}

profile_command_alias() {
  case "$1" in
    internal) printf '%s\n' "internal" ;;
    openai-official) printf '%s\n' "official" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

is_supported_split_request() {
  local profile="$1"
  local app_profile_override="$2"
  [[ "$profile" == "internal" ]] || return 1
  is_official_profile_alias "$app_profile_override"
}

print_section() {
  printf '\n== %s ==\n' "$1"
}

run_switch_step() {
  local profile="$1"
  local mode="$2"
  shift 2
  if [[ "$mode" == "dry-run" ]]; then
    run_switcher switch "$profile" --dry-run "$@"
  else
    run_switcher switch "$profile" "$@"
  fi
}

run_switch_apply_step() {
  local profile="$1"
  shift
  local action_capture=""
  local step_status=0
  LAST_SWITCH_APP_ACTION=""
  if ! action_capture="$(
    mktemp "${TMPDIR:-/tmp}/codex-switch-app-action.XXXXXX"
  )"; then
    echo "codex-switch: unable to create App-action capture" >&2
    return 1
  fi
  if ! chmod 600 "$action_capture"; then
    rm -f -- "$action_capture"
    echo "codex-switch: unable to protect App-action capture" >&2
    return 1
  fi
  if run_switch_step "$profile" apply "$@" | awk \
    -v action_capture="$action_capture" '
      /^App action: (preserve|rebind)$/ {
        print $3 > action_capture
        close(action_capture)
      }
      {
        print
        fflush()
      }
    '; then
    step_status=0
  else
    step_status=$?
  fi
  if [[ -s "$action_capture" ]]; then
    LAST_SWITCH_APP_ACTION="$(sed -n '1p' "$action_capture")"
  fi
  if ! rm -f -- "$action_capture"; then
    echo "codex-switch: warning: failed to retire App-action capture" >&2
  fi
  return "$step_status"
}

print_active_result_summary() {
  resolve_python_bin
  "$PYTHON_BIN" -B - "$STORE_DIR" "$SCRIPT_DIR" <<'PY' || true
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, sys.argv[2])
from codex_switch_selection import active_profile_selection

store = Path(os.path.expandvars(sys.argv[1])).expanduser()
active_path = store / "active.json"
if not active_path.exists():
    print("Active profile: <none recorded>")
    raise SystemExit(0)
try:
    active = json.loads(active_path.read_text())
except Exception as exc:
    print(f"Active profile: <unavailable: {exc}>")
    raise SystemExit(0)

try:
    if not isinstance(active, dict):
        raise ValueError("active record must be an object")
    selection = active_profile_selection(active)
except Exception as exc:
    print(f"Active profile: <invalid: {exc}>")
    raise SystemExit(0)

print(f"Active profile: {selection.cli_profile}")
print(f"CLI profile: {selection.cli_profile}")
print(f"App profile: {selection.app_profile}")
fields = (
    ("Backup", "backup_dir"),
    ("Shim", "shim_path"),
    ("App CLI", "app_cli_path"),
    ("LaunchAgent", "launch_agent_path"),
)
for label, key in fields:
    value = active.get(key)
    if value:
        print(f"{label}: {value}")
PY
}

print_final_result() {
  local profile="$1"
  local outcome="$2"
  local switch_status="$3"
  local verify_status="$4"
  local doctor_status="$5"
  local status_status="$6"
  local failed_step="${7:-}"
  local app_profile_override="${8:-}"
  local command_alias
  local app_profile_suffix=""
  command_alias="$(profile_command_alias "$profile")"
  if [[ -n "$app_profile_override" ]]; then
    app_profile_suffix=" --app-profile $app_profile_override"
  fi

  print_section "Final result"
  echo "Outcome: $outcome"
  echo "Profile: $profile"
  if [[ -n "$failed_step" ]]; then
    echo "Failed step: $failed_step"
  fi
  case "$switch_status" in
    succeeded) echo "Switch: succeeded" ;;
    skipped) echo "Switch: not run" ;;
    *) echo "Switch: failed${failed_step:+ at $failed_step} (exit $switch_status)" ;;
  esac
  case "$verify_status" in
    passed) echo "Verify: passed" ;;
    skipped) echo "Verify: skipped" ;;
    not-run) echo "Verify: not run" ;;
    *) echo "Verify: failed (exit $verify_status)" ;;
  esac
  case "$doctor_status" in
    passed) echo "Doctor: passed" ;;
    skipped) echo "Doctor: skipped" ;;
    not-run) echo "Doctor: not run" ;;
    *) echo "Doctor: failed (exit $doctor_status)" ;;
  esac
  case "$status_status" in
    printed) echo "Status: printed" ;;
    skipped) echo "Status: skipped" ;;
    not-run) echo "Status: not run" ;;
    *) echo "Status: failed (exit $status_status)" ;;
  esac

  if [[ "$switch_status" == "succeeded" ]]; then
    print_active_result_summary
  fi

  echo "Next steps:"
  case "$outcome" in
    SUCCESS)
      if [[ "$LAST_SWITCH_APP_ACTION" == "rebind" ]] \
        || [[ -z "$LAST_SWITCH_APP_ACTION" && -z "$app_profile_override" ]]; then
        echo "- Restart ChatGPT if it was already running."
      fi
      echo "- Verify active state: codex-switch status"
      ;;
    "ACTION REQUIRED")
      if [[ "$failed_step" == "shared synchronization" ]]; then
        echo "- Review the Shared configuration section above and fix the reported cause."
        echo "- Preview shared synchronization: codex-switch sync-shared --dry-run"
        echo "- Re-run shared synchronization: codex-switch sync-shared"
        echo "- Re-run doctor: codex-switch doctor"
      elif [[ "$failed_step" == "plugin repair" ]]; then
        echo "- Review the Plugin repair section above and fix the install error."
        echo "- If it reports a running ChatGPT app-server, quit ChatGPT completely before retrying."
        echo "- Re-run plugin repair: codex-switch repair-plugins $profile"
        echo "- Re-run verification: codex-switch verify $profile --repair=safe"
        echo "- Re-run doctor: codex-switch doctor"
      elif [[ "$failed_step" == "verification" ]]; then
        echo "- Review the Verification section above and fix each listed issue."
        echo "- Re-run verification: codex-switch verify $profile --repair=safe"
        echo "- If it mentions running ChatGPT or app-server, quit ChatGPT completely and reopen it."
        echo "- Re-run doctor: codex-switch doctor"
      else
        echo "- Review the Doctor section above and fix each listed issue."
        echo "- If it mentions running ChatGPT or app-server, quit ChatGPT completely and reopen it."
        echo "- Re-run doctor: codex-switch doctor"
        echo "- Check active state: codex-switch status"
      fi
      ;;
    "DRY RUN OK")
      echo "- Apply the switch: codex-switch $command_alias$app_profile_suffix"
      ;;
    *)
      echo "- Fix the error printed above."
      echo "- Preview again: codex-switch $command_alias$app_profile_suffix --dry-run"
      ;;
  esac
}

switch_profile() {
  local profile="$1"
  shift
  local dry_run=0
  local show_status=1
  local run_doctor=1
  local run_plugin_repair=1
  local run_verify=1
  local app_server_smoke=0
  local runtime_smoke=0
  local responses_tool_smoke=0
  local verification_report=0
  local exec_smoke=""
  local update_check=1
  local auto_login=1
  local app_profile_override=""
  local switch_args=()

  while (($#)); do
    case "$1" in
      -h|--help|help)
        usage
        return 0
        ;;
      --dry-run)
        dry_run=1
        ;;
      --no-status)
        show_status=0
        ;;
      --skip-doctor|--no-doctor)
        run_doctor=0
        ;;
      --skip-plugin-repair|--no-plugin-repair)
        run_plugin_repair=0
        ;;
      --skip-verify|--no-verify)
        run_verify=0
        ;;
      --app-server-smoke)
        app_server_smoke=1
        ;;
      --runtime-smoke)
        runtime_smoke=1
        ;;
      --responses-tool-smoke)
        responses_tool_smoke=1
        ;;
      --verification-report)
        verification_report=1
        ;;
      --exec-smoke)
        if [[ $# -lt 2 ]]; then
          echo "$1 requires a value" >&2
          exit 2
        fi
        exec_smoke="$2"
        shift
        ;;
      --skip-update-check|--no-update-check)
        update_check=0
        ;;
      --keep-version)
        echo "--keep-version is only supported with codex-switch split." >&2
        return 2
        ;;
      --skip-login|--no-login)
        auto_login=0
        ;;
      --snapshot)
        switch_args+=(--config-mode snapshot)
        ;;
      --app-profile=*)
        app_profile_override="${1#--app-profile=}"
        switch_args+=("$1")
        ;;
      --shared-config-base|--config-mode|--app-profile)
        if [[ $# -lt 2 ]]; then
          echo "$1 requires a value" >&2
          exit 2
        fi
        if [[ "$1" == "--app-profile" ]]; then
          app_profile_override="$2"
        fi
        switch_args+=("$1" "$2")
        shift
        ;;
      --)
        shift
        switch_args+=("$@")
        break
        ;;
      *)
        switch_args+=("$1")
        ;;
    esac
    shift
  done

  print_section "Dry-run plan"
  local plan_status=0
  # Bash 3.2 treats empty array expansion as unbound under `set -u`.
  if run_switch_step "$profile" dry-run ${switch_args[@]+"${switch_args[@]}"}; then
    plan_status=0
  else
    plan_status=$?
    print_final_result "$profile" "FAILED" "skipped" "not-run" "not-run" "not-run" "dry-run plan" "$app_profile_override"
    return "$plan_status"
  fi
  if [[ "$dry_run" == 1 ]]; then
    if is_supported_split_request "$profile" "$app_profile_override"; then
      print_section "Shared configuration"
      echo "Shared configuration: will synchronize openai-official -> internal after a successful switch."
      echo "Dry-run: shared synchronization was not applied."
    fi
    print_final_result "$profile" "DRY RUN OK" "skipped" "not-run" "not-run" "not-run" "" "$app_profile_override"
    return
  fi

  if [[ "$update_check" == 1 ]]; then
    print_section "Update check"
    local update_status=0
    if run_update_check_for_switch "$profile" "$app_profile_override"; then
      update_status=0
    else
      update_status=$?
      print_final_result "$profile" "FAILED" "skipped" "not-run" "not-run" "not-run" "update check" "$app_profile_override"
      return "$update_status"
    fi
  else
    print_section "Update check"
    echo "Update check: skipped by command option."
  fi

  if [[ "$auto_login" == 1 ]]; then
    print_section "Profile preparation"
    local login_status=0
    if maybe_login_for_switch "$profile"; then
      login_status=0
    else
      login_status=$?
      print_final_result "$profile" "FAILED" "skipped" "not-run" "not-run" "not-run" "profile preparation" "$app_profile_override"
      return "$login_status"
    fi
  elif [[ "$profile" == "openai-official" ]]; then
    print_section "Profile preparation"
    echo "Official login: skipped by command option."
  fi

  print_section "Switch"
  local switch_status=0
  if run_switch_apply_step "$profile" \
    ${switch_args[@]+"${switch_args[@]}"}; then
    switch_status=0
  else
    switch_status=$?
    print_final_result "$profile" "FAILED" "$switch_status" "not-run" "not-run" "not-run" "switch" "$app_profile_override"
    return "$switch_status"
  fi

  if is_supported_split_request "$profile" "$app_profile_override"; then
    print_section "Shared configuration"
    local shared_sync_status=0
    if run_switcher sync-shared; then
      shared_sync_status=0
    else
      shared_sync_status=$?
      print_final_result "$profile" "ACTION REQUIRED" "succeeded" "not-run" "not-run" "not-run" "shared synchronization" "$app_profile_override"
      return "$shared_sync_status"
    fi
  fi

  local repair_status="skipped"
  if [[ "$run_plugin_repair" == 1 ]]; then
    print_section "Plugin repair"
    if run_switcher repair-plugins "$profile"; then
      repair_status="passed"
    else
      repair_status=$?
      if [[ "$profile" != "internal" || "$INTERNAL_AUTO_UPDATED" != 1 ]]; then
        print_final_result "$profile" "ACTION REQUIRED" "succeeded" "not-run" "not-run" "not-run" "plugin repair" "$app_profile_override"
        return "$repair_status"
      fi
      if [[ "$INTERNAL_AUTO_UPDATE_SCOPE" == "cli-only" ]]; then
        echo "Plugin repair failed; running the mandatory internal CLI verification before returning." >&2
      else
        echo "Plugin repair failed; running the mandatory internal update compatibility verification before returning." >&2
      fi
    fi
  else
    print_section "Plugin repair"
    echo "Plugin repair: skipped by command option."
  fi

  local auto_update_forced_verify=0
  if [[ "$profile" == "internal" && "$INTERNAL_AUTO_UPDATED" == 1 ]] \
    && [[ "$run_verify" != 1 ]]; then
    run_verify=1
    auto_update_forced_verify=1
  fi

  local verify_status="skipped"
  if [[ "$run_verify" == 1 ]]; then
    print_section "Verification"
    if [[ "$auto_update_forced_verify" == 1 ]]; then
      if [[ "$INTERNAL_AUTO_UPDATE_SCOPE" == "cli-only" ]]; then
        echo "Verification: --skip-verify ignored because an internal CLI update requires runtime verification."
      else
        echo "Verification: --skip-verify ignored because an internal update requires compatibility verification."
      fi
    fi
    local verify_args=("$profile")
    if [[ "$app_server_smoke" == 1 ]] \
      || [[ "$profile" == "internal" \
        && "$INTERNAL_AUTO_UPDATED" == 1 \
        && "$INTERNAL_AUTO_UPDATE_SCOPE" != "cli-only" ]]; then
      verify_args+=(--app-server-smoke)
    fi
    if [[ "$runtime_smoke" == 1 ]] \
      || [[ "$profile" == "internal" \
        && "$INTERNAL_AUTO_UPDATED" == 1 \
        && "$INTERNAL_AUTO_UPDATE_SCOPE" == "cli-only" ]]; then
      verify_args+=(--runtime-smoke)
    fi
    if [[ -n "$exec_smoke" ]]; then
      verify_args+=(--exec-smoke "$exec_smoke")
    fi
    if [[ "$responses_tool_smoke" == 1 ]]; then
      verify_args+=(--responses-tool-smoke)
    fi
    if [[ "$verification_report" == 1 ]]; then
      verify_args+=(--report)
    fi
    if run_switcher verify "${verify_args[@]}"; then
      verify_status="passed"
      if [[ "$profile" == "internal" && "$INTERNAL_AUTO_UPDATED" == 1 ]]; then
        if [[ "$repair_status" == "passed" || "$repair_status" == "skipped" ]]; then
          echo "Auto-update: completed. Internal Codex is now ${INTERNAL_UPDATE_AFTER_VERSION:-<unavailable>}."
        elif [[ "$INTERNAL_AUTO_UPDATE_SCOPE" == "cli-only" ]]; then
          echo "Auto-update: CLI verification passed; plugin repair still requires action."
        else
          echo "Auto-update: compatibility verification passed; plugin repair still requires action."
        fi
      fi
    else
      verify_status=$?
      print_final_result "$profile" "ACTION REQUIRED" "succeeded" "$verify_status" "not-run" "not-run" "verification" "$app_profile_override"
      return "$verify_status"
    fi
  else
    print_section "Verification"
    echo "Verification: skipped by command option."
  fi

  if [[ "$repair_status" != "passed" && "$repair_status" != "skipped" ]]; then
    print_final_result "$profile" "ACTION REQUIRED" "succeeded" "$verify_status" "not-run" "not-run" "plugin repair" "$app_profile_override"
    return "$repair_status"
  fi

  local doctor_status="skipped"
  if [[ "$run_doctor" == 1 ]]; then
    print_section "Doctor"
    if run_switcher doctor; then
      doctor_status="passed"
    else
      doctor_status=$?
    fi
  fi

  local status_status="skipped"
  if [[ "$show_status" == 1 ]]; then
    print_section "Status"
    if run_switcher status; then
      status_status="printed"
    else
      status_status=$?
    fi
  fi

  if [[ "$verify_status" == "passed" || "$verify_status" == "skipped" ]] \
    && [[ "$doctor_status" == "passed" || "$doctor_status" == "skipped" ]] \
    && [[ "$status_status" == "printed" || "$status_status" == "skipped" ]]; then
    print_final_result "$profile" "SUCCESS" "succeeded" "$verify_status" "$doctor_status" "$status_status" "" "$app_profile_override"
    return 0
  fi

  print_final_result "$profile" "ACTION REQUIRED" "succeeded" "$verify_status" "$doctor_status" "$status_status" "" "$app_profile_override"
  if [[ "$verify_status" != "passed" && "$verify_status" != "skipped" ]]; then
    return "$verify_status"
  fi
  if [[ "$doctor_status" != "passed" && "$doctor_status" != "skipped" ]]; then
    return "$doctor_status"
  fi
  return "$status_status"
}

profile_codex_bin() {
  local profile="$1"
  resolve_python_bin
  "$PYTHON_BIN" -B - "$STORE_DIR" "$profile" <<'PY'
import json
import os
import sys
from pathlib import Path

store = Path(os.path.expandvars(sys.argv[1])).expanduser()
profile = sys.argv[2]
manifest_path = store / "profiles" / profile / "manifest.json"
try:
    manifest = json.loads(manifest_path.read_text())
except FileNotFoundError:
    print(f"missing manifest: {manifest_path}", file=sys.stderr)
    raise SystemExit(2)
except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
    print(
        f"{profile} profile manifest is invalid: {manifest_path}: {error}",
        file=sys.stderr,
    )
    raise SystemExit(2)
if not isinstance(manifest, dict):
    print(
        f"{profile} profile manifest is invalid: {manifest_path}: "
        "root must be an object",
        file=sys.stderr,
    )
    raise SystemExit(2)
codex_bin = manifest.get("codex_bin")
if not isinstance(codex_bin, str) or not codex_bin.strip():
    print(
        f"{profile} profile manifest is invalid: {manifest_path}: "
        "codex_bin must be a non-empty string",
        file=sys.stderr,
    )
    raise SystemExit(2)
print(codex_bin)
PY
}

profile_advisory_codex_bin() {
  local profile="$1"
  resolve_python_bin
  "$PYTHON_BIN" -I -B - \
    "$SCRIPT_DIR" \
    "$STORE_DIR" \
    "$profile" \
    ${GLOBAL_ARGS[@]+"${GLOBAL_ARGS[@]}"} <<'PY'
import os
import sys
from pathlib import Path

script_dir = Path(sys.argv[1])
store_root = Path(os.path.expandvars(sys.argv[2])).expanduser()
profile = sys.argv[3]
raw_args = sys.argv[4:]
sys.path.insert(0, str(script_dir))

from codex_switch_constants import DEFAULT_LAUNCH_AGENT_LABEL, SwitchError
from codex_switch_official_release import resolve_profile_advisory_cli
from codex_switch_store import Store


def expanded(value: str) -> Path:
    return Path(os.path.expandvars(value)).expanduser()


official_home = Path.home() / ".codex"
internal_home = None
launch_agent = (
    Path.home()
    / "Library"
    / "LaunchAgents"
    / f"{DEFAULT_LAUNCH_AGENT_LABEL}.plist"
)
launch_label = DEFAULT_LAUNCH_AGENT_LABEL
index = 0
while index < len(raw_args):
    option = raw_args[index]
    if index + 1 >= len(raw_args):
        print(f"{option} requires a value", file=sys.stderr)
        raise SystemExit(2)
    value = raw_args[index + 1]
    if option in {"--official-codex-home", "--live-codex-home"}:
        official_home = expanded(value)
    elif option == "--internal-codex-home":
        internal_home = expanded(value)
    elif option == "--launch-agent-path":
        launch_agent = expanded(value)
    elif option == "--launch-agent-label":
        launch_label = value
    index += 2

store = Store(
    store_root,
    official_codex_home=official_home,
    launch_agent_path=launch_agent,
    launch_agent_label=launch_label,
    internal_codex_home=internal_home,
)
try:
    print(resolve_profile_advisory_cli(store, profile))
except (OSError, SwitchError, ValueError, TypeError) as error:
    print(
        f"{profile} advisory CLI resolution failed: {error}",
        file=sys.stderr,
    )
    raise SystemExit(2)
PY
}

