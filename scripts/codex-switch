profile_uses_file_auth() {
  local profile="$1"
  local config_path
  config_path="$(profile_config_path "$profile")"
  [[ -f "$config_path" ]] || return 1
  grep -Eq '^[[:space:]]*cli_auth_credentials_store[[:space:]]*=[[:space:]]*"file"[[:space:]]*$' "$config_path"
}

maybe_login_for_switch() {
  local profile="$1"
  if [[ "$profile" != "openai-official" ]]; then
    return
  fi
  if skip_login_from_env; then
    echo "Official login: skipped by CODEX_SWITCH_SKIP_LOGIN."
    return
  fi
  if ! profile_uses_file_auth "$profile"; then
    return
  fi

  local auth_path
  auth_path="$(profile_auth_path "$profile")"
  if [[ -f "$auth_path" ]]; then
    return
  fi

  echo "Official login: missing $auth_path; running login before switch."
  if run_switcher login "$profile"; then
    true
  else
    return $?
  fi
  if [[ ! -f "$auth_path" ]]; then
    echo "Official login did not create $auth_path; aborting switch." >&2
    return 2
  fi
}

extract_version() {
  resolve_python_bin
  "$PYTHON_BIN" -I -B -c '
import sys

sys.path.insert(0, sys.argv[1])
from codex_switch_update_policy import extract_semantic_version

version = extract_semantic_version(sys.stdin.read())
if version is not None:
    print(version)
' "$SCRIPT_DIR"
}

env_setup_command() {
  if [[ -n "${CODEX_SWITCH_ENV_SETUP:-}" ]]; then
    printf '%s\n' "$CODEX_SWITCH_ENV_SETUP"
    return
  fi
  local bundled="$SCRIPT_DIR/codex_env_setup"
  if [[ -x "$bundled" ]]; then
    printf '%s\n' "$bundled"
    return
  fi
  echo "codex-switch environment helper not found in this installation; reinstall codex-switch." >&2
  return 1
}

run_env_setup() {
  local env_setup status
  if env_setup="$(env_setup_command)"; then
    true
  else
    status=$?
    return "$status"
  fi
  if [[ "${1:-}" == "update-internal" ]]; then
    shift
    run_update_internal_env_setup "$env_setup" auto "$@"
    return
  fi
  "$env_setup" "$@"
}

update_internal_args_have_version() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --version|--codex-install-version|--version=*|--codex-install-version=*)
        return 0
        ;;
    esac
  done
  return 1
}

update_internal_args_have_dry_run() {
  local arg
  for arg in "$@"; do
    if [[ "$arg" == "--dry-run" ]]; then
      return 0
    fi
  done
  return 1
}

update_internal_args_have_install_dir() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --install-dir|--install-dir=*)
        return 0
        ;;
    esac
  done
  return 1
}

NORMALIZED_INTERNAL_UPDATE_ARGS=()

normalize_internal_update_arguments() {
  local normalized_option option value
  NORMALIZED_INTERNAL_UPDATE_ARGS=()
  while (($#)); do
    option="$1"
    case "$option" in
      --version|--codex-install-version|--install-dir|--internal-bin|--official-bin|--installer-url|--latest-url|--model|--azure-base-url|--codex-install-base-url)
        if [[ $# -lt 2 || "$2" == -* ]]; then
          echo "$option requires a non-option value" >&2
          return 2
        fi
        value="$2"
        normalized_option="$option"
        case "$option" in
          --version|--codex-install-version)
            normalized_option="--version"
            ;;
        esac
        NORMALIZED_INTERNAL_UPDATE_ARGS+=("$normalized_option" "$value")
        shift 2
        ;;
      --version=*|--codex-install-version=*|--install-dir=*|--internal-bin=*|--official-bin=*|--installer-url=*|--latest-url=*|--model=*|--azure-base-url=*|--codex-install-base-url=*)
        value="${option#*=}"
        if [[ -z "$value" || "$value" == -* ]]; then
          echo "${option%%=*} requires a non-option value" >&2
          return 2
        fi
        normalized_option="${option%%=*}"
        case "$normalized_option" in
          --version|--codex-install-version)
            normalized_option="--version"
            ;;
        esac
        NORMALIZED_INTERNAL_UPDATE_ARGS+=("$normalized_option" "$value")
        shift
        ;;
      *)
        NORMALIZED_INTERNAL_UPDATE_ARGS+=("$option")
        shift
        ;;
    esac
  done
}

update_internal_requested_version() {
  local value=""
  while (($#)); do
    case "$1" in
      --version|--codex-install-version)
        if [[ $# -lt 2 ]]; then
          echo "$1 requires a value" >&2
          return 2
        fi
        value="$2"
        shift 2
        ;;
      --version=*|--codex-install-version=*)
        value="${1#*=}"
        shift
        ;;
      *)
        shift
        ;;
    esac
  done
  [[ -n "$value" ]] || return 1
  printf '%s\n' "$value"
}

update_internal_requested_install_dir() {
  local value=""
  while (($#)); do
    case "$1" in
      --install-dir)
        if [[ $# -lt 2 ]]; then
          echo "$1 requires a value" >&2
          return 2
        fi
        value="$2"
        shift 2
        ;;
      --install-dir=*)
        value="${1#*=}"
        shift
        ;;
      *)
        shift
        ;;
    esac
  done
  [[ -n "$value" ]] || return 1
  expand_shell_path "$value"
}

validate_internal_update_bound_install_dir() {
  local requested_dir="$1"
  local bound_bin="$2"
  resolve_python_bin
  "$PYTHON_BIN" -I -B - "$requested_dir" "$bound_bin" <<'PY'
import os
import sys
from pathlib import Path

requested = Path(os.path.expandvars(sys.argv[1])).expanduser()
bound = Path(os.path.expandvars(sys.argv[2])).expanduser()
try:
    requested = requested.resolve(strict=True)
    bound_parent = bound.parent.resolve(strict=True)
except OSError as error:
    print(
        f"update-internal: install directory is unavailable: {error}",
        file=sys.stderr,
    )
    raise SystemExit(2)
if requested != bound_parent:
    print(
        "update-internal: --install-dir must match the internal profile "
        f"binary directory: expected {bound_parent}, observed {requested}",
        file=sys.stderr,
    )
    raise SystemExit(2)
PY
}

UPDATE_INTERNAL_FORWARD_ARGS=()

update_internal_forward_arguments() {
  UPDATE_INTERNAL_FORWARD_ARGS=()
  while (($#)); do
    case "$1" in
      --install-dir|--internal-bin)
        if [[ $# -lt 2 ]]; then
          echo "$1 requires a value" >&2
          return 2
        fi
        shift 2
        ;;
      --install-dir=*|--internal-bin=*)
        shift
        ;;
      *)
        UPDATE_INTERNAL_FORWARD_ARGS+=("$1")
        shift
        ;;
    esac
  done
}

internal_update_candidate_dir_for_bound() {
  local bound_bin="$1"
  resolve_python_bin
  "$PYTHON_BIN" -I -B - "$bound_bin" <<'PY'
import os
import secrets
import stat
import sys
from pathlib import Path

bound = Path(os.path.expandvars(sys.argv[1])).expanduser()
if not bound.is_absolute() or bound.name != "codex":
    print(
        f"update-internal: bound binary path is invalid: {bound}",
        file=sys.stderr,
    )
    raise SystemExit(2)
try:
    bound_state = bound.lstat()
    parent_state = bound.parent.lstat()
except OSError as error:
    print(
        f"update-internal: bound binary is unavailable: {error}",
        file=sys.stderr,
    )
    raise SystemExit(2)
if (
    stat.S_ISLNK(bound_state.st_mode)
    or not stat.S_ISREG(bound_state.st_mode)
    or bound_state.st_mode & 0o111 == 0
    or stat.S_ISLNK(parent_state.st_mode)
    or not stat.S_ISDIR(parent_state.st_mode)
):
    print(
        f"update-internal: bound binary route is unsafe: {bound}",
        file=sys.stderr,
    )
    raise SystemExit(2)
for _attempt in range(128):
    candidate = (
        bound.parent
        / f".codex-internal-update-{secrets.token_hex(12)}"
    )
    if not os.path.lexists(candidate):
        print(candidate)
        raise SystemExit(0)
print(
    "update-internal: could not allocate a private candidate path",
    file=sys.stderr,
)
raise SystemExit(1)
PY
}

internal_update_backup_path_for_bound() {
  local bound_bin="$1"
  printf '%s/.codex-internal-backup\n' "$(dirname "$bound_bin")"
}

print_internal_update_promotion_dry_run() {
  local bound_bin="$1"
  local candidate_bin="$2"
  local backup_bin="$3"
  local promotion_scope="${4:-full}"
  if [[ "$promotion_scope" == "cli-only" ]]; then
    echo "[DRY-RUN] CLI-only checks:"
    echo "[DRY-RUN]   Exact staged candidate version and SHA-256"
    echo "[DRY-RUN] Artifact set:"
    echo "[DRY-RUN]   Internal manifest only"
    echo "[DRY-RUN] Promotion order:"
    echo "[DRY-RUN]   $bound_bin -> $backup_bin"
    echo "[DRY-RUN]   $candidate_bin -> $bound_bin"
    echo "[DRY-RUN]   Digest-bound internal manifest"
    echo "[DRY-RUN] Internal App readiness remains unverified"
    return
  fi
  echo "[DRY-RUN] Parity checks:"
  echo "[DRY-RUN]   Capability receipt: staged candidate"
  echo "[DRY-RUN]   Parity receipt: staged candidate"
  echo "[DRY-RUN]   Model catalog overlay: staged candidate"
  echo "[DRY-RUN] Artifact set:"
  echo "[DRY-RUN]   Projected profile config"
  echo "[DRY-RUN]   Projected shared config when changed"
  echo "[DRY-RUN]   Projected active runtime config when materialized"
  echo "[DRY-RUN]   Managed launcher and internal manifest"
  echo "[DRY-RUN] Promotion order:"
  echo "[DRY-RUN]   $bound_bin -> $backup_bin"
  echo "[DRY-RUN]   $candidate_bin -> $bound_bin"
  echo "[DRY-RUN]   Runtime artifacts, launcher, then manifest"
  echo "[DRY-RUN] Locked revalidation: bound binary, candidate binary, internal manifest, official reference, source catalog, capability receipt, and config inputs"
  echo "[DRY-RUN] Bound app-server smoke: post-promotion only"
}

internal_update_version_is_valid() {
  local version="$1"
  resolve_python_bin
  "$PYTHON_BIN" -I -B -c '
import sys

sys.path.insert(0, sys.argv[1])
from codex_switch_update_policy import parse_semantic_version

raise SystemExit(0 if parse_semantic_version(sys.argv[2]) is not None else 1)
' "$SCRIPT_DIR" "$version"
}

internal_update_install_dir_for_profile_bin() {
  local codex_bin="$1"
  local context="$2"
  if [[ "$(basename "$codex_bin")" != "codex" ]]; then
    echo "$context: profile codex_bin basename must be codex: $codex_bin" >&2
    return 2
  fi
  dirname "$codex_bin"
}

resolve_internal_update_target_bin() {
  local install_dir profile_bin argument previous="" explicit_bin=""
  for argument in "$@"; do
    if [[ "$previous" == "--internal-bin" ]]; then
      explicit_bin="$(expand_shell_path "$argument")"
    fi
    previous="$argument"
  done
  if install_dir="$(update_internal_requested_install_dir "$@")"; then
    if [[ -n "$explicit_bin" && "$explicit_bin" != "${install_dir%/}/codex" ]]; then
      echo "update-internal: --internal-bin conflicts with --install-dir." >&2
      return 2
    fi
    printf '%s/codex\n' "${install_dir%/}"
    return
  fi
  if [[ -n "$explicit_bin" ]]; then
    printf '%s\n' "$explicit_bin"
    return
  fi
  if [[ -n "${CODEX_INSTALL_DIR:-}" ]]; then
    install_dir="$(expand_shell_path "$CODEX_INSTALL_DIR")"
    printf '%s/codex\n' "${install_dir%/}"
    return
  fi
  if profile_bin="$(profile_codex_bin internal 2>/dev/null)" \
    && [[ -n "$profile_bin" ]]; then
    printf '%s\n' "$profile_bin"
    return
  fi
  printf '%s/.local/bin/codex\n' "$HOME"
}

internal_profile_home() {
  local index
  for ((index = 0; index < ${#GLOBAL_ARGS[@]}; index++)); do
    if [[ "${GLOBAL_ARGS[$index]}" == "--internal-codex-home" ]]; then
      expand_shell_path "${GLOBAL_ARGS[$((index + 1))]}"
      return
    fi
  done
  resolve_python_bin
  "$PYTHON_BIN" -I -B -c '
import json
import os
import sys
from pathlib import Path

store = Path(os.path.expandvars(sys.argv[1])).expanduser()
manifest_path = store / "profiles" / "internal" / "manifest.json"
try:
    manifest = json.loads(manifest_path.read_text())
except FileNotFoundError:
    manifest = {}
raw_home = manifest.get("codex_home")
home = (
    Path(os.path.expandvars(str(raw_home))).expanduser()
    if raw_home
    else store / "homes" / "internal"
)
print(home)
' "$STORE_DIR"
}

verify_internal_update_compatibility() {
  local codex_bin="$1"
  local home
  if home="$(internal_profile_home)"; then
    true
  else
    return $?
  fi
  resolve_python_bin
  "$PYTHON_BIN" -I -B -c '
import sys
from pathlib import Path

sys.path.insert(0, sys.argv[1])
from codex_switch_verify import run_app_server_smoke

code, output = run_app_server_smoke(sys.argv[2], Path(sys.argv[3]))
if code != 0:
    print(
        f"update-internal: app-server smoke failed (exit {code}): {output}",
        file=sys.stderr,
    )
    raise SystemExit(code if 0 < code < 256 else 1)
print("App-server smoke: passed")
' "$SCRIPT_DIR" "$codex_bin" "$home"
}

verify_internal_update_target() {
  local codex_bin="$1"
  local target_version="$2"
  local context="$3"
  local after after_version probe_status
  if after="$("$codex_bin" --version 2>&1)"; then
    true
  else
    probe_status=$?
    echo "$context: version probe failed (exit $probe_status)." >&2
    return "$probe_status"
  fi
  after_version="$(printf '%s\n' "$after" | extract_version)"
  if [[ "$after_version" != "$target_version" ]]; then
    echo "$context: failed postcondition; expected $target_version but observed ${after_version:-<unparseable>}." >&2
    return 1
  fi
  printf '%s\n' "$after_version"
}

run_first_internal_install() {
  local env_setup="$1" codex_bin="$2"
  shift 2
  local target_version latest_url latest_tag argument previous=""
  local install_args=()
  resolve_python_bin
  if "$PYTHON_BIN" -I -B "$SCRIPT_DIR/codex_switch_first_install.py" \
    --target "$codex_bin" --store "$STORE_DIR" --check; then
    true
  else
    return $?
  fi
  if update_internal_args_have_version "$@"; then
    target_version="$(update_internal_requested_version "$@")" || return $?
  else
    latest_url="${CODEX_SWITCH_INTERNAL_LATEST_URL:-${CODEX_INTERNAL_LATEST_URL:-https://github.com/SDGLBL/codex/releases/latest}}"
    for argument in "$@"; do
      if [[ "$previous" == "--latest-url" ]]; then
        latest_url="$argument"
      fi
      previous="$argument"
    done
    latest_tag="$(latest_internal_tag_from_url "$latest_url")" || {
      echo "update-internal: cannot resolve a version for first installation; verify the release and pass --version." >&2
      return 1
    }
    target_version="$("$PYTHON_BIN" -I -B "$SCRIPT_DIR/codex_switch_first_install.py" \
      --target "$codex_bin" --store "$STORE_DIR" --release-tag "$latest_tag" \
      --blocked-versions "$(internal_blocked_versions)" \
      --fallback-version "$(internal_fallback_version)")" || return $?
  fi
  if ! internal_update_version_is_valid "$target_version"; then
    echo "update-internal: first installation requires a valid semantic version." >&2
    return 2
  fi
  update_internal_forward_arguments "$@" || return $?
  if update_internal_args_have_dry_run "$@"; then
    install_args+=(--dry-run)
  fi
  exec "$PYTHON_BIN" -I -B "$SCRIPT_DIR/codex_switch_first_install.py" \
    --target "$codex_bin" --store "$STORE_DIR" --helper "$env_setup" \
    --version "$target_version" ${install_args[@]+"${install_args[@]}"} \
    -- ${UPDATE_INTERNAL_FORWARD_ARGS[@]+"${UPDATE_INTERNAL_FORWARD_ARGS[@]}"}
}

run_public_staged_update() {
  local action="$1" helper selected="" latest_url latest_tag profile_manifest
  shift
  resolve_python_bin
  helper="$(env_setup_command)" || return $?
  if [[ "$action" == stage ]]; then
    local item current=0 help=0
    for item in "$@"; do
      [[ "$item" != --current ]] || current=1
      [[ "$item" != --help && "$item" != -h ]] || help=1
    done
    if [[ "$current" == 0 && "$help" == 0 ]] && ! update_internal_args_have_version "$@"; then
      profile_manifest="$(profile_manifest_path internal)" || return $?
      if [[ -f "$profile_manifest" ]]; then
        check_internal_update >&2 || return $?
        if [[ "$INTERNAL_UPDATE_UNCERTAIN" == 1 ]]; then
          echo "update-internal: no safe automatic target; verify and specify --version." >&2
          return 1
        fi
        if [[ "$INTERNAL_UPDATE_NEEDED" == 1 ]]; then
          set -- "$@" --version "$INTERNAL_UPDATE_TARGET_VERSION"
        else
          set -- "$@" --current
        fi
      else
        latest_url="${CODEX_SWITCH_INTERNAL_LATEST_URL:-${CODEX_INTERNAL_LATEST_URL:-https://github.com/SDGLBL/codex/releases/latest}}"
        local previous=""
        for item in "$@"; do
          [[ "$previous" != --latest-url ]] || latest_url="$item"
          [[ "$item" != --latest-url=* ]] || latest_url="${item#*=}"
          previous="$item"
        done
        latest_tag="$(latest_internal_tag_from_url "$latest_url")" || return $?
        selected="$("$PYTHON_BIN" -I -B -c 'import sys; sys.path.insert(0, sys.argv[1]); from codex_switch_first_install import first_version; print(first_version(*sys.argv[2:]))' \
          "$SCRIPT_DIR" "$latest_tag" "$(internal_blocked_versions)" "$(internal_fallback_version)")" || return $?
        set -- "$@" --version "$selected"
      fi
    fi
  fi
  exec "$PYTHON_BIN" -I -B "$SCRIPT_DIR/codex_switch_update.py" \
    ${GLOBAL_ARGS[@]+"${GLOBAL_ARGS[@]}"} --helper "$helper" "$action" "$@"
}

run_update_engine_and_wait() {
  # Automatic update returns to the switch workflow, so it cannot exec. Forward
  # cancellation and wait for the engine to finish its bounded recovery first.
  local update_child="" update_status update_signal=""
  local saved_hup saved_int saved_term
  saved_hup="$(trap -p HUP)"
  saved_int="$(trap -p INT)"
  saved_term="$(trap -p TERM)"
  trap 'update_signal=HUP; if [[ -n "$update_child" ]]; then trap "" HUP INT TERM; kill -TERM "$update_child" 2>/dev/null || true; fi' HUP
  trap 'update_signal=INT; if [[ -n "$update_child" ]]; then trap "" HUP INT TERM; kill -TERM "$update_child" 2>/dev/null || true; fi' INT
  trap 'update_signal=TERM; if [[ -n "$update_child" ]]; then trap "" HUP INT TERM; kill -TERM "$update_child" 2>/dev/null || true; fi' TERM
  "$@" &
  update_child=$!
  if [[ -n "$update_signal" ]]; then
    trap "" HUP INT TERM
    # Background Bash children initially ignore INT; TERM cancels even before
    # Python installs its handlers. Preserve the caller's exit status below.
    kill -TERM "$update_child" 2>/dev/null || true
  fi
  if wait "$update_child"; then update_status=0; else update_status=$?; fi
  if [[ -n "$update_signal" ]]; then
    if wait "$update_child"; then update_status=0; else update_status=$?; fi
    # A cancelled automatic update must never continue to profile switching.
    case "$update_signal" in HUP) update_status=129;; INT) update_status=130;; TERM) update_status=143;; esac
  fi
  trap - HUP INT TERM
  [[ -z "$saved_hup" ]] || eval "$saved_hup"
  [[ -z "$saved_int" ]] || eval "$saved_int"
  [[ -z "$saved_term" ]] || eval "$saved_term"
  return "$update_status"
}

run_update_internal_env_setup() {
  local env_setup="$1"
  shift
  local promotion_scope="$1"
  shift
  local helper_status target_version codex_bin
  local profile_bin="" explicit_version=0
  local profile_manifest=""
  local requested_install_dir=""
  local candidate_dir="" candidate_bin="" backup_bin=""
  local helper_args=()
  case "$promotion_scope" in
    full|cli-only|auto) ;;
    *)
      echo "update-internal: invalid promotion scope: $promotion_scope" >&2
      return 2
      ;;
  esac
  if profile_manifest="$(profile_manifest_path internal)"; then
    true
  else
    return $?
  fi
  if normalize_internal_update_arguments "$@"; then
    set -- ${NORMALIZED_INTERNAL_UPDATE_ARGS[@]+"${NORMALIZED_INTERNAL_UPDATE_ARGS[@]}"}
  else
    return $?
  fi
  if [[ ! -e "$profile_manifest" && ! -L "$profile_manifest" ]]; then
    codex_bin="$(resolve_internal_update_target_bin "$@")" || return $?
    run_first_internal_install "$env_setup" "$codex_bin" "$@"
    return $?
  fi
  if update_internal_args_have_version "$@"; then
    explicit_version=1
    if target_version="$(update_internal_requested_version "$@")"; then
      true
    else
      return $?
    fi
  else
    if check_internal_update; then
      true
    else
      helper_status=$?
      echo "update-internal: ordered update check failed; pass --version explicitly only after verifying the intended target." >&2
      return "$helper_status"
    fi
    if [[ "$INTERNAL_UPDATE_UNCERTAIN" == 1 ]]; then
      echo "update-internal: no safe automatic target; pass --version explicitly only after verifying the intended target." >&2
      return 1
    fi
    if [[ "$INTERNAL_UPDATE_NEEDED" != 1 ]]; then
      echo "update-internal: no automatic update required."
      return 0
    fi
    target_version="$INTERNAL_UPDATE_TARGET_VERSION"
  fi
  if ! internal_update_version_is_valid "$target_version"; then
    echo "update-internal: target version must be a semantic version: $target_version" >&2
    return 2
  fi

  if [[ ! -e "$profile_manifest" && ! -L "$profile_manifest" ]]; then
    echo "update-internal: the internal profile must exist before a parity-safe update." >&2
    return 2
  fi
  if profile_bin="$(profile_codex_bin internal)"; then
    codex_bin="$profile_bin"
  else
    helper_status=$?
    return "$helper_status"
  fi
  if [[ "$(basename "$codex_bin")" != "codex" ]]; then
    echo "update-internal: profile codex_bin basename must be codex: $codex_bin" >&2
    return 2
  fi

  if requested_install_dir="$(update_internal_requested_install_dir "$@")"; then
    if validate_internal_update_bound_install_dir \
      "$requested_install_dir" \
      "$codex_bin"; then
      true
    else
      return $?
    fi
  elif [[ -n "${CODEX_INSTALL_DIR:-}" ]]; then
    requested_install_dir="$(expand_shell_path "$CODEX_INSTALL_DIR")"
    if validate_internal_update_bound_install_dir \
      "$requested_install_dir" \
      "$codex_bin"; then
      true
    else
      return $?
    fi
  fi
  if candidate_dir="$(internal_update_candidate_dir_for_bound "$codex_bin")"; then
    true
  else
    return $?
  fi
  candidate_bin="${candidate_dir%/}/codex"
  backup_bin="$(internal_update_backup_path_for_bound "$codex_bin")"

  if update_internal_forward_arguments "$@"; then
    true
  else
    return $?
  fi

  if [[ "$explicit_version" == 1 ]]; then
    helper_args=(
      ${UPDATE_INTERNAL_FORWARD_ARGS[@]+"${UPDATE_INTERNAL_FORWARD_ARGS[@]}"}
    )
  else
    helper_args=(--version "$target_version")
    helper_args+=(
      ${UPDATE_INTERNAL_FORWARD_ARGS[@]+"${UPDATE_INTERNAL_FORWARD_ARGS[@]}"}
    )
  fi
  helper_args+=(
    --internal-bin "$codex_bin"
    --install-dir "$candidate_dir"
  )

  if ! update_internal_args_have_dry_run "$@"; then
    resolve_python_bin
    run_update_engine_and_wait "$PYTHON_BIN" -I -B "$SCRIPT_DIR/codex_switch_update.py" \
      ${GLOBAL_ARGS[@]+"${GLOBAL_ARGS[@]}"} --helper "$env_setup" _one-shot \
      --scope "$promotion_scope" --version "$target_version" \
      --internal-bin "$codex_bin" --install-dir "$(dirname "$codex_bin")" \
      ${UPDATE_INTERNAL_FORWARD_ARGS[@]+"${UPDATE_INTERNAL_FORWARD_ARGS[@]}"}
    return $?
  fi

  if "$env_setup" update-internal "${helper_args[@]}"; then
    helper_status=0
  else
    helper_status=$?
    echo "update-internal: helper exited $helper_status." >&2
    return "$helper_status"
  fi
  if update_internal_args_have_dry_run "$@"; then
    print_internal_update_promotion_dry_run \
      "$codex_bin" \
      "$candidate_bin" \
      "$backup_bin" \
      "$promotion_scope"
    return 0
  fi
  local promotion_args=(
    promote-internal-update
    --bound-bin "$codex_bin"
    --candidate-bin "$candidate_bin"
    --backup-bin "$backup_bin"
    --target-version "$target_version"
  )
  if [[ "$promotion_scope" == "cli-only" ]]; then
    promotion_args+=(--cli-only)
  fi
  run_switcher "${promotion_args[@]}"
}

print_version() {
  if [[ -n "$CODEX_SWITCH_VERSION" ]]; then
    printf '%s\n' "$CODEX_SWITCH_VERSION"
    return
  fi
  if [[ -f "$VERSION_FILE" ]]; then
    sed -n '1p' "$VERSION_FILE"
    return
  fi
  printf '%s\n' "0.1.1-dev"
}

INTERNAL_PROFILE_CODEX_BIN=""
INTERNAL_UPDATE_NEEDED=0
INTERNAL_UPDATE_UNCERTAIN=0
INTERNAL_UPDATE_CHECK_FATAL=0
INTERNAL_AUTO_UPDATED=0
INTERNAL_AUTO_UPDATE_SCOPE=""
INTERNAL_UPDATE_TARGET_VERSION=""
INTERNAL_UPDATE_DECISION=""
INTERNAL_UPDATE_DECISION_REASON=""
INTERNAL_UPDATE_AFTER_VERSION=""

internal_blocked_versions() {
  printf '%s\n' "${CODEX_SWITCH_INTERNAL_BLOCKED_VERSIONS-0.142.5}"
}

internal_fallback_version() {
  printf '%s\n' "${CODEX_SWITCH_INTERNAL_FALLBACK_VERSION-0.142.4}"
}

internal_update_policy_decision() {
  local current_version="$1"
  local latest_version="$2"
  local blocked_versions="$3"
  local fallback_version="$4"
  resolve_python_bin
  "$PYTHON_BIN" -I -B -c '
import sys

sys.path.insert(0, sys.argv[1])
from codex_switch_update_policy import decide_internal_update

blocked = tuple(
    item
    for item in sys.argv[4].replace(",", " ").split()
    if item
)
decision = decide_internal_update(
    current_version=sys.argv[2],
    latest_version=sys.argv[3],
    blocked_versions=blocked,
    fallback_version=sys.argv[5] or None,
)
print(decision.outcome)
print(decision.target_version or "")
print(decision.reason)
' \
    "$SCRIPT_DIR" \
    "$current_version" \
    "$latest_version" \
    "$blocked_versions" \
    "$fallback_version"
}

load_internal_update_decision() {
  local decision_output="$1"
  INTERNAL_UPDATE_DECISION="$(
    printf '%s\n' "$decision_output" | sed -n '1p'
  )"
  INTERNAL_UPDATE_TARGET_VERSION="$(
    printf '%s\n' "$decision_output" | sed -n '2p'
  )"
  INTERNAL_UPDATE_DECISION_REASON="$(
    printf '%s\n' "$decision_output" | sed -n '3,$p'
  )"
  case "$INTERNAL_UPDATE_DECISION" in
    up_to_date|upgrade|blocked_fallback|newer_current|failed)
      return 0
      ;;
    *)
      echo "Internal update policy returned an invalid outcome: ${INTERNAL_UPDATE_DECISION:-<empty>}" >&2
      return 1
      ;;
  esac
}

version_in_list() {
  local needle="$1"
  local list="${2//,/ }"
  local item
  for item in $list; do
    if [[ "$item" == "$needle" ]]; then
      return 0
    fi
  done
  return 1
}

internal_version_blocked() {
  local version="$1"
  local blocked
  blocked="$(internal_blocked_versions)"
  [[ -n "$version" && -n "$blocked" ]] || return 1
  version_in_list "$version" "$blocked"
}

latest_release_tag_from_url() {
  local latest_url="$1"
  local max_time="${2:-20}"
  local headers location
  command -v curl >/dev/null 2>&1 || return 1
  headers="$(
    curl -fsSLI --connect-timeout 3 --max-time "$max_time" "$latest_url" \
      2>/dev/null
  )" || return 1
  location="$(printf '%s\n' "$headers" | awk 'tolower($1) == "location:" { print $2 }' | tail -n 1 | tr -d '\r')"
  [[ -n "$location" ]] || return 1
  printf '%s\n' "${location##*/}"
}

latest_internal_tag_from_url() {
  latest_release_tag_from_url "$1" 20
}

official_stable_comparison_decision() {
  local current_output="$1"
  local stable_tag="$2"
  if ! resolve_python_bin; then
    return 1
  fi
  "$PYTHON_BIN" -I -B -c '
import sys

sys.path.insert(0, sys.argv[1])
from codex_switch_official_release import compare_to_official_stable

comparison = compare_to_official_stable(sys.argv[2], sys.argv[3])
print(comparison.outcome)
print(comparison.current_version or "")
print(comparison.stable_version or "")
print("1" if comparison.current_is_prerelease else "0")
print(comparison.reason)
' "$SCRIPT_DIR" "$current_output" "$stable_tag"
}

print_official_stable_advisory() {
  local profile="$1"
  local codex_bin="$2"
  local latest_url="${CODEX_SWITCH_OFFICIAL_LATEST_URL:-https://github.com/openai/codex/releases/latest}"
  local current_output="" stable_tag="" decision_output=""
  local outcome="" current_version="" stable_version=""
  local current_is_prerelease="" reason="" current_status=0

  if current_output="$("$codex_bin" --version 2>&1)"; then
    true
  else
    current_status=$?
    echo "Official stable comparison: unavailable (current version probe failed: exit $current_status)"
    return 0
  fi
  if stable_tag="$(latest_release_tag_from_url "$latest_url" 8)"; then
    true
  else
    echo "Official stable comparison: unavailable (release lookup failed)"
    return 0
  fi
  if decision_output="$(
    official_stable_comparison_decision "$current_output" "$stable_tag"
  )"; then
    true
  else
    echo "Official stable comparison: unavailable (comparison policy failed)"
    return 0
  fi
  outcome="$(printf '%s\n' "$decision_output" | sed -n '1p')"
  current_version="$(printf '%s\n' "$decision_output" | sed -n '2p')"
  stable_version="$(printf '%s\n' "$decision_output" | sed -n '3p')"
  current_is_prerelease="$(printf '%s\n' "$decision_output" | sed -n '4p')"
  reason="$(printf '%s\n' "$decision_output" | sed -n '5,$p')"
  if [[ "$outcome" == "unknown" ]]; then
    echo "Official stable comparison: unavailable ($reason)"
    return 0
  fi
  case "$outcome" in
    behind) reason="behind upstream stable" ;;
    matches) reason="matches upstream stable" ;;
    ahead) reason="ahead of upstream stable" ;;
    *)
      echo "Official stable comparison: unavailable (comparison outcome is invalid)"
      return 0
      ;;
  esac

  echo "Official stable comparison ($profile):"
  if [[ "$profile" == "internal" ]]; then
    echo "Current internal CLI: $current_version"
  else
    echo "Current official CLI: $current_version"
  fi
  echo "Latest openai/codex stable: $stable_version ($stable_tag)"
  echo "Status: $reason"
  if [[ "$current_is_prerelease" == "1" ]]; then
    echo "Current channel: prerelease or vendor build"
  fi
  if [[ "$profile" == "internal" ]]; then
    echo "Advisory only: internal updates remain governed by the internal release source."
  else
    echo "Advisory only: ChatGPT.app remains responsible for the bundled official CLI."
  fi
}

check_internal_update() {
  local codex_bin
  INTERNAL_PROFILE_CODEX_BIN=""
  INTERNAL_UPDATE_NEEDED=0
  INTERNAL_UPDATE_UNCERTAIN=0
  INTERNAL_UPDATE_CHECK_FATAL=0
  INTERNAL_AUTO_UPDATED=0
  INTERNAL_UPDATE_TARGET_VERSION=""
  INTERNAL_UPDATE_DECISION=""
  INTERNAL_UPDATE_DECISION_REASON=""
  INTERNAL_UPDATE_AFTER_VERSION=""
  codex_bin="$(profile_codex_bin internal)"
  INTERNAL_PROFILE_CODEX_BIN="$codex_bin"
  if [[ -z "$codex_bin" || ! -x "$codex_bin" ]]; then
    echo "internal profile codex_bin is missing or not executable: ${codex_bin:-<empty>}" >&2
    exit 2
  fi

  local current current_version current_status latest_url latest_tag latest_version fallback_version blocked_versions
  local decision_output
  if current="$("$codex_bin" --version 2>&1)"; then
    true
  else
    current_status=$?
    INTERNAL_UPDATE_CHECK_FATAL=1
    echo "Internal update check: current version probe failed (exit $current_status)." >&2
    return "$current_status"
  fi
  current_version="$(printf '%s\n' "$current" | extract_version)"
  if [[ -z "$current_version" ]]; then
    INTERNAL_UPDATE_CHECK_FATAL=1
    echo "Internal update check: current version is not valid semantic version output." >&2
    return 1
  fi
  latest_url="${CODEX_SWITCH_INTERNAL_LATEST_URL:-https://github.com/SDGLBL/codex/releases/latest}"
  fallback_version="$(internal_fallback_version)"
  blocked_versions="$(internal_blocked_versions)"

  echo "Internal profile codex: $codex_bin"
  echo "Current: ${current:-<unavailable>}"
  latest_tag=""
  latest_version=""
  if latest_tag="$(latest_internal_tag_from_url "$latest_url")"; then
    latest_version="$(printf '%s\n' "$latest_tag" | extract_version)"
    echo "Latest release tag: ${latest_tag:-<unknown>}"
  else
    echo "Latest release: <unavailable from $latest_url>"
  fi

  if decision_output="$(
    internal_update_policy_decision \
      "$current_version" \
      "$latest_version" \
      "$blocked_versions" \
      "$fallback_version"
  )"; then
    true
  else
    INTERNAL_UPDATE_CHECK_FATAL=1
    echo "Internal update policy failed; refusing automatic update." >&2
    return 1
  fi
  if ! load_internal_update_decision "$decision_output"; then
    INTERNAL_UPDATE_CHECK_FATAL=1
    return 1
  fi

  case "$INTERNAL_UPDATE_DECISION" in
    upgrade)
      INTERNAL_UPDATE_NEEDED=1
      echo "Update: available (ordered upgrade to $INTERNAL_UPDATE_TARGET_VERSION)"
      echo "Preview:"
      echo "  codex-switch update-internal --version $INTERNAL_UPDATE_TARGET_VERSION --dry-run"
      echo "Install:"
      echo "  codex-switch update-internal --version $INTERNAL_UPDATE_TARGET_VERSION"
      ;;
    blocked_fallback)
      INTERNAL_UPDATE_NEEDED=1
      echo "Current internal release status: blocked by codex-switch policy"
      echo "Blocked internal releases: ${blocked_versions:-<none>}"
      echo "Pinned fallback version: $INTERNAL_UPDATE_TARGET_VERSION"
      echo "Update: available (blocked-current fallback)"
      echo "Preview:"
      echo "  codex-switch update-internal --version $INTERNAL_UPDATE_TARGET_VERSION --dry-run"
      echo "Install:"
      echo "  codex-switch update-internal --version $INTERNAL_UPDATE_TARGET_VERSION"
      ;;
    newer_current)
      echo "Update: not needed (healthy current $current_version is newer than reported latest $latest_version)"
      ;;
    up_to_date)
      echo "Update: not needed"
      ;;
    failed)
      INTERNAL_UPDATE_UNCERTAIN=1
      if internal_version_blocked "$latest_version"; then
        echo "Latest release status: blocked by codex-switch policy"
        echo "Blocked internal releases: ${blocked_versions:-<none>}"
      fi
      echo "Update: skipped (no safe automatic target: $INTERNAL_UPDATE_DECISION_REASON)"
      case "$INTERNAL_UPDATE_DECISION_REASON" in
        "blocked versions "*|"blocked current "*)
          INTERNAL_UPDATE_CHECK_FATAL=1
          return 1
          ;;
      esac
      if [[ -z "$latest_version" ]]; then
        echo "Run a dry-run update check with:"
        echo "  codex-switch update-internal --dry-run"
        return 1
      fi
      ;;
  esac
}

check_official_update() {
  local codex_bin
  codex_bin="$(profile_advisory_codex_bin openai-official)"
  if [[ -z "$codex_bin" || ! -x "$codex_bin" ]]; then
    echo "official profile codex_bin is missing or not executable: ${codex_bin:-<empty>}" >&2
    exit 2
  fi
  echo "Official profile codex: $codex_bin"
  echo "Current: $("$codex_bin" --version 2>/dev/null || echo "<unavailable>")"
  echo "Update: managed by ChatGPT.app; codex-switch does not modify the app bundle."
  print_official_stable_advisory openai-official "$codex_bin"
}

check_update() {
  local profile="internal"
  local status=0
  if (($#)); then
    profile="$(normalize_profile "$1")"
  fi
  if [[ "$profile" == "internal" ]]; then
    if check_internal_update; then
      status=0
    else
      status=$?
    fi
    if [[ -n "$INTERNAL_PROFILE_CODEX_BIN" ]]; then
      print_official_stable_advisory internal "$INTERNAL_PROFILE_CODEX_BIN"
    fi
    return "$status"
  else
    check_official_update
  fi
}

skip_update_check_from_env() {
  case "${CODEX_SWITCH_SKIP_UPDATE_CHECK:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

skip_login_from_env() {
  case "${CODEX_SWITCH_SKIP_LOGIN:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

run_update_check_for_switch() {
  local profile="$1"
  local app_profile="${2:-}"
  if [[ -z "$app_profile" ]]; then
    app_profile="$profile"
  else
    app_profile="$(normalize_profile "$app_profile")"
  fi
  if skip_update_check_from_env; then
    echo "Update check: skipped by CODEX_SWITCH_SKIP_UPDATE_CHECK."
    return
  fi

  echo "Checking Codex CLI update for $profile..."
  if [[ "$profile" == "internal" ]]; then
    local check_status=0
    if check_internal_update; then
      check_status=0
    else
      check_status=$?
      if [[ "$INTERNAL_UPDATE_CHECK_FATAL" == 1 ]]; then
        return "$check_status"
      fi
      echo "Update check did not complete; continuing with switch." >&2
      if [[ -n "$INTERNAL_PROFILE_CODEX_BIN" ]]; then
        print_official_stable_advisory internal "$INTERNAL_PROFILE_CODEX_BIN"
      fi
      return 0
    fi
    if [[ "$INTERNAL_UPDATE_NEEDED" == 1 ]]; then
      local update_status=0
      if run_internal_auto_update \
        "$INTERNAL_PROFILE_CODEX_BIN" \
        "$app_profile"; then
        update_status=0
      else
        update_status=$?
        return "$update_status"
      fi
    elif [[ "$INTERNAL_UPDATE_UNCERTAIN" == 1 ]]; then
      echo "Auto-update: skipped because no safe automatic target was selected." >&2
    fi
    print_official_stable_advisory internal "$INTERNAL_PROFILE_CODEX_BIN"
    return
  fi

  if ! check_update "$profile"; then
    echo "Update check did not complete; continuing with switch." >&2
  fi
}

run_internal_auto_update() {
  local codex_bin="$1"
  local app_profile="${2:-internal}"
  local promotion_scope="full"
  local env_setup helper_status
  if [[ "$app_profile" == "openai-official" ]]; then
    promotion_scope="cli-only"
  fi
  if env_setup="$(env_setup_command)"; then
    true
  else
    helper_status=$?
    echo "Auto-update: failed to resolve the internal update helper." >&2
    return "$helper_status"
  fi
  if [[ -z "$INTERNAL_UPDATE_TARGET_VERSION" ]]; then
    echo "Auto-update: failed because the intended target version is empty." >&2
    return 2
  fi

  echo "Auto-update: internal Codex update detected."
  if [[ "$promotion_scope" == "cli-only" ]]; then
    echo "Auto-update: running staged CLI-only internal promotion."
  else
    echo "Auto-update: running staged parity-safe internal promotion."
  fi
  if run_update_internal_env_setup \
    "$env_setup" \
    "$promotion_scope" \
    --version "$INTERNAL_UPDATE_TARGET_VERSION"; then
    helper_status=0
  else
    helper_status=$?
    echo "Auto-update: failed; staged promotion exited $helper_status." >&2
    return "$helper_status"
  fi
  INTERNAL_AUTO_UPDATED=1
  INTERNAL_AUTO_UPDATE_SCOPE="$promotion_scope"
  INTERNAL_UPDATE_AFTER_VERSION="$INTERNAL_UPDATE_TARGET_VERSION"
  if [[ "$promotion_scope" == "cli-only" ]]; then
    echo "Auto-update: installed $INTERNAL_UPDATE_AFTER_VERSION; CLI promotion passed and post-switch runtime verification is required before completion."
  else
    echo "Auto-update: installed $INTERNAL_UPDATE_AFTER_VERSION; parity handshake passed and post-switch verification is required before completion."
  fi
}

install_wrapper() {
  local target="${CODEX_SWITCH_INSTALL_PATH:-$HOME/.local/bin/codex-switch}"
  mkdir -p "$(dirname "$target")"
  ln -sf "$SCRIPT_DIR/codex-switch" "$target"
  echo "Installed: $target -> $SCRIPT_DIR/codex-switch"
  echo "Run: codex-switch status"
}

while (($#)); do
  case "$1" in
    --store-dir)
      if [[ $# -lt 2 ]]; then
        echo "--store-dir requires a value" >&2
        exit 2
      fi
      STORE_DIR="$(expand_shell_path "$2")"
      GLOBAL_ARGS+=("$1" "$2")
      shift 2
      ;;
    --official-codex-home|--live-codex-home|--internal-codex-home|--launch-agent-path|--launch-agent-label)
      if [[ $# -lt 2 ]]; then
        echo "$1 requires a value" >&2
        exit 2
      fi
      GLOBAL_ARGS+=("$1" "$2")
      shift 2
      ;;
    --skip-self-update)
      SKIP_SELF_UPDATE=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

cmd="${1:-}"
if [[ -z "$cmd" ]]; then
  usage
  exit 2
fi
shift

if [[ "$cmd" == "split" ]]; then
  normalize_split_command_args "$@"
  if [[ "$SPLIT_APP_PROFILE_OVERRIDE" == 1 ]]; then
    echo "codex-switch split already selects the official App; do not pass --app-profile." >&2
    exit 2
  fi
  if [[ "$SPLIT_KEEP_VERSION" == 1 ]]; then
    SKIP_SELF_UPDATE=1
  fi
fi

if split_preview_requested "$cmd" "$@"; then
  SKIP_SELF_UPDATE=1
fi

case "$cmd" in
  internal|i|split|official|openai|openai-official|o)
    case "${1:-}" in
      -h|--help|help) SKIP_SELF_UPDATE=1 ;;
    esac
    ;;
esac
maybe_self_update "$cmd"

case "$cmd" in
  internal|i)
    switch_profile internal "$@"
    ;;
  split)
    switch_profile internal --app-profile official \
      ${SPLIT_COMMAND_ARGS[@]+"${SPLIT_COMMAND_ARGS[@]}"}
    ;;
  official|openai|openai-official|o)
    switch_profile openai-official "$@"
    ;;
  check-update|update-check)
    check_update "$@"
    ;;
  update-internal)
    case "${1:-}" in
      stage|apply|status|cancel)
        run_public_staged_update "$@"
        ;;
      *) run_env_setup update-internal "$@" ;;
    esac
    ;;
  check-internal)
    run_env_setup check-internal "$@"
    ;;
  check-official)
    run_env_setup check-official "$@"
    ;;
  desktop-guidance)
    run_env_setup desktop-guidance "$@"
    ;;
  env)
    run_env_setup "$@"
    ;;
  install)
    install_wrapper
    ;;
  version|--version|-v)
    print_version
    ;;
  login-internal)
    run_switcher login internal "$@"
    ;;
  login-official)
    run_switcher login openai-official "$@"
    ;;
  init|capture|switch|restore|status|list|doctor|repair-plugins|sync-shared|verify|shim-env|login|set-bin|set-app-bin)
    run_switcher "$cmd" "$@"
    ;;
  raw)
    run_switcher "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
